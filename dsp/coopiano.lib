//################################ coopiano.lib ##########################################
// coopiano library. Its official prefix is `cp`.
//
// A Faust model of coopiano, the physically modelled piano synthesizer of Peter
// Cooper (`piano.hpp` and `instrument.hpp`, C++17, MIT license): a nonlinear felt
// hammer, unison strings with two polarizations, longitudinal phantom partials,
// action noises, dampers and sustain pedal, a sympathetic string register, a modal
// soundboard imaged over four bridge regions, and the room reverb of `reverb.hpp`.
//
// The C++ engine prepares each note offline (a 32 times oversampled contact solve,
// then a bank of decaying phasors). This library computes the same model as a
// stream, at any sample rate:
//
// * every string mode is a complex one-pole resonator whose real part is the
//   displacement (the convention of `polarization_state`), driven by the hammer
//   force with a first-order hold; the vertical (prompt) and horizontal (slow)
//   polarizations are two resonators sharing the force in the C++ proportions;
// * the hammer is solved implicitly at the audio rate: the felt law
//   `F = K d^p (1 + 0.12 d')`, compression and compression rate taken at the
//   current sample, meets the strings' direct response to the current force;
// * a phantom partial is the product of two mode states: the product of two
//   decaying phasors is the decaying phasor at the sum frequency;
// * fixed random draws and quantities only a contact solve gives come from the
//   C++ model itself, through `coopiano_tables.lib` (`scripts/gen_tables.py`).
//
// Everything that depends on the note and the voicing is computed in faust-rs
// `ondemand` domains clocked by a change of either, not at every block. The
// library therefore needs faust-rs; compile it in double precision.
//
// The coopiano library is organized into 15 sections:
//
// * [Sizes](#sizes)
// * [Voicing controls](#voicing-controls)
// * [Tuning and helpers](#tuning-and-helpers)
// * [Key parameters](#key-parameters)
// * [Bridge voicing](#bridge-voicing)
// * [Mode slots](#mode-slots)
// * [Resonators and hammer](#resonators-and-hammer)
// * [Voice internals](#voice-internals)
// * [Action noises](#action-noises)
// * [Voice](#voice)
// * [Compilation helpers](#compilation-helpers)
// * [Bridge regions](#bridge-regions)
// * [Sympathetic register](#sympathetic-register)
// * [Soundboard](#soundboard)
// * [Room and output](#room-and-output)
//
// It should be used using the `cp` environment, with `coopiano_tables.lib` in the
// import path:
//
// ```
// cp = library("coopiano.lib");
// process = cp.voice(60, 0.5, button("gate"));
// ```
//
// The polyphonic instrument is `dsp/coopiano.dsp`: `cp.voice_out` as the voice,
// `cp.body` as the effect.
//
// #### References
//
// * coopiano: `piano.hpp`, `instrument.hpp`, `reverb.hpp` (Peter Cooper, 2026, MIT)
// * faust-coopiano: `README.md`, `paper/faust-coopiano.pdf`, `results/`
//########################################################################################

declare name "coopiano";
declare version "0.2.4";
declare author "Stéphane Letz";
declare copyright "Faust model: GRAME, 2026; coopiano C++ model: Peter Cooper, 2026";
declare license "MIT";

ba = library("basics.lib");
de = library("delays.lib");
fi = library("filters.lib");
ma = library("maths.lib");
no = library("noises.lib");
ro = library("routes.lib");
si = library("signals.lib");
tb = library("coopiano_tables.lib");

//======================================== Sizes =========================================
// Compile-time sizes of a voice and of the body. They are constant numerical
// expressions: changing them changes the generated code and the cost.
//========================================================================================

//--------------------------------------`(cp.)NS`---------------------------------------
// Number of mode slots of a voice, shared by its unison strings string by string:
// with `ns` strings, slot `k` is partial `k % (NS/ns) + 1` of string `k / (NS/ns)`.
// A one-string bass key gets `NS` partials, a trichord `NS/3` per string (32 for
// `NS = 96`: a C3 then loses the C++ content above 4.5 kHz, at most -44 dB of the
// energy at the attack). `NS` must be a multiple of 24 (6 for the slot layout, 8
// for the parameter domains).
//
// #### Usage
//
// ```
// NS : _
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// NS_test = cp.NS;
// ```
//----------------------------------------------------------------------------------------
declare NS license "MIT";
NS = 96;

//--------------------------------------`(cp.)NP`---------------------------------------
// Number of slots that parent phantom partials (all of them by default). A
// multiple of 8.
//
// #### Usage
//
// ```
// NP : _
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// NP_test = cp.NP;
// ```
//----------------------------------------------------------------------------------------
declare NP license "MIT";
NP = 96;

//-------------------------------------`(cp.)DMAX`--------------------------------------
// Largest partial distance of a phantom pair. `piano.hpp` pairs partials up to a
// distance of 3; the amplitude of a pair falls as `0.55^d`, so the omitted
// distance-3 term is 15 dB below the strongest pair.
//
// #### Usage
//
// ```
// DMAX : _
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// DMAX_test = cp.DMAX;
// ```
//----------------------------------------------------------------------------------------
declare DMAX license "MIT";
DMAX = 2;

//------------------------------------`(cp.)REGIONS`------------------------------------
// Number of soundboard bridge regions (`SOUNDBOARD_REGIONS` in `piano.hpp`): a
// voice hands the body one force per region.
//
// #### Usage
//
// ```
// REGIONS : _
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// REGIONS_test = cp.REGIONS;
// ```
//----------------------------------------------------------------------------------------
declare REGIONS license "MIT";
REGIONS = 4;

//=================================== Voicing controls ===================================
// The controls of coopiano's `default.ini`, with its defaults and ranges, grouped
// as in the file. They are internal definitions (their UI paths are the interface);
// `dsp/coopiano.dsp` shows them all.
//
// | group | control | default | range | effect |
// |---|---|---|---|---|
// | hammer | `stiffness_scale` | 0.9 | 0.25..4 | felt stiffness `K` |
// | hammer | `mass_scale` | 1.3 | 0.5..2 | hammer mass |
// | hammer | `felt_width_scale` | 1.4 | 0.5..2 | contact width on the string |
// | hammer | `maximum_velocity_mps` | 6 | 2..8 | hammer speed at velocity 1 (m/s) |
// | hammer | `velocity_exponent` | 1.8 | 0.75..2.5 | speed response exponent |
// | strings | `decay_scale` | 1.1 | 0.25..2 | late fundamental T60 |
// | strings | `treble_decay_scale` | 0.38 | 0.1..2 | treble T60, blended C6..F#6 |
// | strings | `partial_loss_scale` | 1 | 0.25..4 | quadratic frequency-dependent loss |
// | strings | `inharmonicity_scale` | 0.85 | 0..3 | string stiffness |
// | strings | `unison_detune_scale` | 0.35 | 0..3 | unison detuning |
// | strings | `treble_unison_detune` | 0.875 | 0..3 | minimum treble detune, blended G5..C6 |
// | strings | `fast_decay_scale` | 0.95 | 0.75..2 | prompt/late decay ratio |
// | strings | `horizontal_ratio` | 0.4 | 0..1 | slow/prompt polarization amplitude |
// | strings | `longitudinal_gain` | 0.22 | 0..0.5 | phantom partials (per newton) |
// | strings | `bridge_coupling` | 1 | 0..3 | string-soundboard admittance coupling |
// | tone | `fundamental_boost_db` | 0 | -6..12 | fundamental, peaking A2..A3 |
// | tone | `lower_overtone_cut_db` | 0 | 0..12 | overtones around 220..1000 Hz |
// | tone | `bridge_curve_scale` | 1 | 0..2 | depth of the bridge EQ |
// | tone | `mid_gain_db` | -1.5 | -9..9 | bell EQ gain |
// | tone | `mid_frequency_hz` | 1200 | 200..5000 | bell EQ frequency |
// | tone | `mid_width_octaves` | 0.9 | 0.2..2 | bell EQ width (Gaussian sigma) |
// | resonance | `gain` | 0.18 | 0..1 | sympathetic register (0 bypasses) |
// | resonance | `maximum_decay_seconds` | 12 | 1..30 | open-string T60 cap |
// | resonance | `damper_decay_seconds` | 0.18 | 0.03..2 | closed-string T60 |
// | resonance | `transition_seconds` | 0.04 | 0.001..0.2 | damper transition |
// | resonance | `own_drive` | 0 | 0..1 | share of a key's force driving its own resonators |
// | reverb | `mix` | 0.3 | 0..1 | wet level (0 bypasses) |
// | reverb | `decay_seconds` | 1.1 | 0.2..4 | low-frequency room T60 |
// | reverb | `predelay_ms` | 12 | 0..80 | predelay |
// | reverb | `damping_hz` | 5500 | 500..12000 | feedback low-pass |
// | action | `knock_gain` | 1 | 0..4 | keybed and structural knock |
// | action | `damper_scale` | 1 | 0.25..4 | damper release time |
// | action | `pedal` | 0 | 0..1 | sustain pedal, 0 up .. 1 down (CC64/127) |
// | action | `output_gain` | 0.0011 | 0..0.01 | output gain before the limiter |
//
// The soundboard controls of `default.ini` (corners, decay, ripple, mode density,
// `spread`, `position_depth`) are fixed by the fit of `coopiano_tables.lib`: change
// them in `ref/dump.cpp` and run `make tables`.
//========================================================================================

// UI groups of the controls.
_g_hammer(x) = vgroup("hammer", x);
_g_strings(x) = vgroup("strings", x);
_g_tone(x) = vgroup("tone", x);
_g_reson(x) = vgroup("resonance", x);
_g_room(x) = vgroup("reverb", x);
_g_action(x) = vgroup("action", x);


// Hammer: felt stiffness, mass, felt width, maximum speed, velocity exponent.
_h_stiffness = _g_hammer(hslider("stiffness_scale", 0.9, 0.25, 4, 0.01));
_h_mass = _g_hammer(hslider("mass_scale", 1.3, 0.5, 2, 0.01));
_h_width = _g_hammer(hslider("felt_width_scale", 1.4, 0.5, 2, 0.01));
_h_vmax = _g_hammer(hslider("maximum_velocity_mps", 6, 2, 8, 0.01));
_h_vexp = _g_hammer(hslider("velocity_exponent", 1.8, 0.75, 2.5, 0.01));


// Strings: decays, partial loss, inharmonicity, unison detuning, decay ratio,
// polarization ratio, phantom gain, bridge coupling.
_s_decay = _g_strings(hslider("decay_scale", 1.1, 0.25, 2, 0.01));
_s_treble_decay = _g_strings(hslider("treble_decay_scale", 0.38, 0.1, 2, 0.01));
_s_loss = _g_strings(hslider("partial_loss_scale", 1, 0.25, 4, 0.01));
_s_inharm = _g_strings(hslider("inharmonicity_scale", 0.85, 0, 3, 0.01));
_s_detune = _g_strings(hslider("unison_detune_scale", 0.35, 0, 3, 0.01));
_s_treble_detune = _g_strings(hslider("treble_unison_detune", 0.875, 0, 3, 0.001));
_s_fast = _g_strings(hslider("fast_decay_scale", 0.95, 0.75, 2, 0.01));
_s_hratio = _g_strings(hslider("horizontal_ratio", 0.4, 0, 1, 0.01));
_s_long = _g_strings(hslider("longitudinal_gain", 0.22, 0, 0.5, 0.01));
_s_coupling = _g_strings(hslider("bridge_coupling", 1, 0, 3, 0.01));


// Tone: fundamental boost, lower overtone cut, bridge EQ depth, bell EQ.
_t_fund = _g_tone(hslider("fundamental_boost_db", 0, -6, 12, 0.1));
_t_lowcut = _g_tone(hslider("lower_overtone_cut_db", 0, 0, 12, 0.1));
_t_curve = _g_tone(hslider("bridge_curve_scale", 1, 0, 2, 0.01));
_t_midg = _g_tone(hslider("mid_gain_db", -1.5, -9, 9, 0.1));
_t_midf = _g_tone(hslider("mid_frequency_hz", 1200, 200, 5000, 1));
_t_midw = _g_tone(hslider("mid_width_octaves", 0.9, 0.2, 2, 0.01));


// Sympathetic register: gain, open and closed T60, damper transition, own drive.
_r_gain = _g_reson(hslider("gain", 0.18, 0, 1, 0.01));
_r_maxdecay = _g_reson(hslider("maximum_decay_seconds", 12, 1, 30, 0.1));
_r_damper = _g_reson(hslider("damper_decay_seconds", 0.18, 0.03, 2, 0.01));
_r_transition = _g_reson(hslider("transition_seconds", 0.04, 0.001, 0.2, 0.001));
_r_own = _g_reson(hslider("own_drive", 0, 0, 1, 0.01));


// Room: wet level, T60, predelay, damping.
_v_mix = _g_room(hslider("mix", 0.3, 0, 1, 0.01));
_v_decay = _g_room(hslider("decay_seconds", 1.1, 0.2, 4, 0.01));
_v_predelay = _g_room(hslider("predelay_ms", 12, 0, 80, 0.1));
_v_damping = _g_room(hslider("damping_hz", 5500, 500, 12000, 1));


// Action: knock gain, damper release scale, sustain pedal, output gain.
_a_knock = _g_action(hslider("knock_gain", 1, 0, 4, 0.01));
_a_damper = _g_action(hslider("damper_scale", 1, 0.25, 4, 0.01));
_pedal = _g_action(hslider("pedal", 0, 0, 1, 0.01));
_out_gain = _g_action(hslider("output_gain", 0.0011, 0, 0.01, 0.0001));


//================================== Tuning and helpers ==================================
// The stretched tuning of the piano, the conversion from a frequency to a note
// number, and the small helpers the key parameters are written with.
//========================================================================================

// pi, the sample period, ln(1000) (the decay rate of a T60 is ln(1000)/T60).
_PI = ma.PI;
_T = 1.0 / ma.SR;
_LN1000 = log(1000.0);

// x limited to [lo, hi].
_clamp(lo, hi, x) = max(lo, min(hi, x));

// Smoothstep of x clamped to [0, 1]: the C++ model's register crossfades.
_smooth01(x) = c * c * (3.0 - 2.0 * c) with { c = _clamp(0.0, 1.0, x); };

// Base-2 logarithm.
_log2(x) = log(x) / log(2.0);

// Decibels to a linear gain.
_db2lin(d) = pow(10.0, d / 20.0);

// A per-sample coefficient of piano.hpp, written for 44.1 kHz, at the current rate.
_pole44(a) = pow(a, 44100.0 / ma.SR);


//-------------------------------------`(cp.)mtof`--------------------------------------
// Fundamental frequency of a key with coopiano's Railsback stretch (`midi_to_freq`):
// the bass tuned flat and the treble sharp, mild through the middle, steep at both
// ends. `m` may be fractional.
//
// #### Usage
//
// ```
// mtof(m) : _
// ```
//
// Where:
//
// * `m`: note number (MIDI, 21 for A0 .. 108 for C8)
//
// #### Test
// ```
// cp = library("coopiano.lib");
// mtof_test = cp.mtof(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare mtof license "MIT";
mtof(m) = 440.0 * pow(2.0, (m - 69.0 + dev / 100.0) / 12.0)
with {
    x = (m - 69.0) / select2(m < 69.0, 39.0, 48.0);
    x3 = x * x * x;
    dev = 14.0 * x3 + 16.0 * x3 * x3 * x;
};

//------------------------------------`(cp.)freq2m`-------------------------------------
// Note number of a frequency, the inverse of the equal-tempered `freq` a
// polyphonic architecture sends, rounded to a thousandth of a semitone so that
// equal-tempered frequencies give integer keys exactly (the register thresholds of
// the model compare note numbers). The stretch is applied by `mtof` afterwards.
//
// #### Usage
//
// ```
// freq2m(f) : _
// ```
//
// Where:
//
// * `f`: equal-tempered frequency in Hz
//
// #### Test
// ```
// cp = library("coopiano.lib");
// freq2m_test = cp.freq2m(hslider("freq", 440, 20, 20000, 1));
// ```
//----------------------------------------------------------------------------------------
declare freq2m license "MIT";
freq2m(f) = floor((69.0 + 12.0 * _log2(f / 440.0)) * 1000.0 + 0.5) / 1000.0;


// Piecewise log-linear interpolation over the note number (`interp_log`),
// written out per point count so that the evaluator needs no list pattern
// matching: one segment, the clamped ends, then curves of 4, 5, 7 and 8 points.
_lseg(m, x0, y0, x1, y1) = (m > x0) * (m <= x1) * y0 * pow(y1 / y0, (m - x0) / (x1 - x0));
_lends(m, x0, y0, xn, yn, inner) = select2(m <= x0, select2(m >= xn, inner, yn), y0);
_ilog4(m, x0, y0, x1, y1, x2, y2, x3, y3) = _lends(m, x0, y0, x3, y3,
    _lseg(m, x0, y0, x1, y1) + _lseg(m, x1, y1, x2, y2) + _lseg(m, x2, y2, x3, y3));
_ilog5(m, x0, y0, x1, y1, x2, y2, x3, y3, x4, y4) = _lends(m, x0, y0, x4, y4,
    _lseg(m, x0, y0, x1, y1) + _lseg(m, x1, y1, x2, y2) + _lseg(m, x2, y2, x3, y3) + _lseg(m, x3, y3, x4, y4));
_ilog7(m, x0, y0, x1, y1, x2, y2, x3, y3, x4, y4, x5, y5, x6, y6) = _lends(m, x0, y0, x6, y6,
    _lseg(m, x0, y0, x1, y1) + _lseg(m, x1, y1, x2, y2) + _lseg(m, x2, y2, x3, y3)
    + _lseg(m, x3, y3, x4, y4) + _lseg(m, x4, y4, x5, y5) + _lseg(m, x5, y5, x6, y6));
_ilog8(m, x0, y0, x1, y1, x2, y2, x3, y3, x4, y4, x5, y5, x6, y6, x7, y7) = _lends(m, x0, y0, x7, y7,
    _lseg(m, x0, y0, x1, y1) + _lseg(m, x1, y1, x2, y2) + _lseg(m, x2, y2, x3, y3) + _lseg(m, x3, y3, x4, y4)
    + _lseg(m, x4, y4, x5, y5) + _lseg(m, x5, y5, x6, y6) + _lseg(m, x6, y6, x7, y7));


// Bridge admittance (`BridgeAdmittance`, a random modal sum tabulated by the C++
// model) at f Hz, linear between the 1 Hz table points; beyond 12 kHz, the real
// part is its mean and the imaginary part zero.
_adm_at(tbl, beyond, f) = select2(f >= 12000.0, v0 + (fc - i) * (v1 - v0), beyond)
with {
    fc = _clamp(0.0, 11999.0, f);
    i = int(fc);
    v0 = tbl, i : rdtable;
    v1 = tbl, i + 1 : rdtable;
};
_adm_re(f) = _adm_at(tb.adm_re, tb.adm_mean, f);
_adm_im(f) = _adm_at(tb.adm_im, 0.0, f);


//==================================== Key parameters ====================================
// `make_key_params` of `piano.hpp` as functions of the note number `m` (fractional
// allowed) and the voicing controls. They are computed at control rate, and inside
// the voice only when the note or the voicing changes.
//========================================================================================

//------------------------------------`(cp.)key_f0`-------------------------------------
// Fundamental frequency of the key in Hz (the stretched `mtof`).
//
// #### Usage
//
// ```
// key_f0(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_f0_test = cp.key_f0(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_f0 license "MIT";
key_f0(m) = mtof(m);

//-------------------------------------`(cp.)key_L`-------------------------------------
// Speaking length of the string in metres: a concert-grand-like scale from
// 1.92 m (A0) to 0.052 m (C8), log-linear between seven points.
//
// #### Usage
//
// ```
// key_L(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_L_test = cp.key_L(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_L license "MIT";
key_L(m) = _ilog7(m, 21, 1.92, 36, 1.30, 48, 0.92, 60, 0.65, 69, 0.41, 84, 0.185, 108, 0.052);

//-------------------------------------`(cp.)key_T`-------------------------------------
// String tension in newtons: 760 N below E2, 700 N above.
//
// #### Usage
//
// ```
// key_T(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_T_test = cp.key_T(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_T license "MIT";
key_T(m) = select2(m < 40.0, 700.0, 760.0);

//------------------------------------`(cp.)key_mu`-------------------------------------
// Linear density of the string in kg/m, from the ideal wave speed `2 L f0`
// and the tension.
//
// #### Usage
//
// ```
// key_mu(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_mu_test = cp.key_mu(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_mu license "MIT";
key_mu(m) = key_T(m) / (c * c) with { c = 2.0 * key_L(m) * key_f0(m); };

//------------------------------------`(cp.)key_ms`-------------------------------------
// Mass of the speaking length in kg.
//
// #### Usage
//
// ```
// key_ms(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_ms_test = cp.key_ms(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_ms license "MIT";
key_ms(m) = key_mu(m) * key_L(m);

//-------------------------------------`(cp.)key_B`-------------------------------------
// Inharmonicity coefficient: rising with frequency in the treble, with a floor
// for the wound bass strings, scaled by `inharmonicity_scale`.
//
// #### Usage
//
// ```
// key_B(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_B_test = cp.key_B(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_B license "MIT";
key_B(m) = (7.0e-4 * pow(f0 / 440.0, 1.4) + 1.0e-4 * _clamp(0.0, 2.2, 55.0 / f0)) * _s_inharm
with { f0 = key_f0(m); };

//-----------------------------------`(cp.)key_alpha`-----------------------------------
// Strike position as a fraction of the speaking length: about 1/8 in the
// bass, shrinking toward the treble.
//
// #### Usage
//
// ```
// key_alpha(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_alpha_test = cp.key_alpha(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_alpha license "MIT";
key_alpha(m) = _ilog4(m, 21, 0.125, 60, 0.118, 84, 0.10, 108, 0.065);

//------------------------------------`(cp.)key_T60`------------------------------------
// Late-stage T60 of the fundamental in seconds (58 s at A0 to 1.2 s at C8),
// shortened by `treble_decay_scale` over C6..F#6 and above, scaled by
// `decay_scale`.
//
// #### Usage
//
// ```
// key_T60(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_T60_test = cp.key_T60(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_T60 license "MIT";
key_T60(m) = _ilog8(m, 21, 58.0, 45, 48.0, 57, 35.0, 69, 24.0, 81, 14.0, 84, 10.0, 96, 4.2, 108, 1.2)
    * treble_decay * _s_decay
with {
    mix = _smooth01((m - 84.0) / 6.0);
    treble_decay = select2(m >= 90.0, 1.0 + (_s_treble_decay - 1.0) * mix, _s_treble_decay);
};

//------------------------------------`(cp.)key_c2`-------------------------------------
// Frequency-dependent loss coefficient: the decay rate of partial n is
// `sigma_1 + c2 (f_n^2 - f_1^2)`, larger for the wound bass strings, scaled by
// `partial_loss_scale`.
//
// #### Usage
//
// ```
// key_c2(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_c2_test = cp.key_c2(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_c2 license "MIT";
key_c2(m) = 1.0e-7 * _ilog7(m, 21, 3.0, 33, 2.5, 44, 1.6, 52, 1.0, 60, 0.6, 72, 0.5, 108, 0.5) * _s_loss;


// Position of the key across the keyboard, 0 (A0) .. 1 (C8), and the smooth
// fade over C6..C7 of the gentler upper attack.
_key_t(m) = _clamp(0.0, 1.0, (m - 21.0) / 87.0);
_key_gentle(m) = _smooth01((m - 84.0) / 12.0);


//------------------------------------`(cp.)key_mh`-------------------------------------
// Hammer mass in kg: 11 g in the bass to 4 g in the treble, scaled by
// `mass_scale`.
//
// #### Usage
//
// ```
// key_mh(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_mh_test = cp.key_mh(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_mh license "MIT";
key_mh(m) = (11.0 - 7.0 * _key_t(m)) * 1.0e-3 * _h_mass;

//-------------------------------------`(cp.)key_p`-------------------------------------
// Exponent of the felt's power law, 2.85 (bass) to 3.7 (treble).
//
// #### Usage
//
// ```
// key_p(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_p_test = cp.key_p(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_p license "MIT";
key_p(m) = 2.85 + 0.85 * _key_t(m);

//-------------------------------------`(cp.)key_K`-------------------------------------
// Felt stiffness in N/m^p: rising across the keyboard, raised further from C5
// to C8 so that the treble strings leave the hammer before several cycles, then
// reduced to 40 % by C7 for a gentler attack; scaled by `stiffness_scale`.
//
// #### Usage
//
// ```
// key_K(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_K_test = cp.key_K(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_K license "MIT";
key_K(m) = pow(10.0, 10.70 + 2.15 * _key_t(m) + 4.0 * th / 34.5 - 0.4 * _key_gentle(m)) * _h_stiffness
with {
    th0 = _clamp(0.0, 36.0, m - 72.0);
    th = select2(th0 < 3.0, th0 - 1.5, th0 * th0 / 6.0);
};

//--------------------------------`(cp.)key_strike_gain`--------------------------------
// Register balance of the bridge output: 0 dB at C5, -3 dB at C6, -9 dB at
// C7, -15 dB at C8, with a listening trim above C6. It never changes the
// contact.
//
// #### Usage
//
// ```
// key_strike_gain(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_strike_gain_test = cp.key_strike_gain(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_strike_gain license "MIT";
key_strike_gain(m) = _db2lin(strike_db - 2.0 * _smooth01((m - 84.0) / 24.0) + _key_gentle(m))
with {
    so = _clamp(0.0, 3.0, (m - 72.0) / 12.0);
    strike_db = select2(so <= 1.0, 3.0 - 6.0 * so, -3.0 * so * so);
};

//-----------------------------------`(cp.)key_fast`------------------------------------
// Ratio of the prompt (vertical) to the late (horizontal) decay rate of the
// low modes: 7 in the bass to 1.5 at C8, scaled by `fast_decay_scale`.
//
// #### Usage
//
// ```
// key_fast(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_fast_test = cp.key_fast(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_fast license "MIT";
key_fast(m) = max(1.0, _ilog5(m, 21, 7.0, 69, 6.5, 84, 3.0, 96, 2.0, 108, 1.5) * _s_fast);

//------------------------------------`(cp.)key_det`------------------------------------
// Unison detune scale: the cents shrink with the register (`620/f0`), scaled
// by `unison_detune_scale`, raised over G5..C6 to `treble_unison_detune`.
//
// #### Usage
//
// ```
// key_det(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_det_test = cp.key_det(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_det license "MIT";
key_det(m) = d0 + _smooth01((m - 79.0) / 5.0) * max(0.0, _s_treble_detune - d0)
with { d0 = _clamp(0.30, 1.0, 620.0 / key_f0(m)) * _s_detune; };

//-----------------------------------`(cp.)key_flong`-----------------------------------
// Fundamental of the string's longitudinal vibration in Hz: 5100 m/s in plain
// steel, slower for the wound bass strings (calibrated on the A1 phantom
// resonance near 1442 Hz).
//
// #### Usage
//
// ```
// key_flong(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_flong_test = cp.key_flong(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_flong license "MIT";
key_flong(m) = 5100.0 * _ilog5(m, 21, 0.75, 33, 0.79, 41, 0.86, 47, 1.0, 108, 1.0) / (2.0 * key_L(m));

//-----------------------------------`(cp.)key_sigh`------------------------------------
// Half-width of the felt's contact on the string in metres (13 mm in the bass
// to 4 mm in the treble), scaled by `felt_width_scale`: a spatial low-pass on
// the hammer's coupling to the modes.
//
// #### Usage
//
// ```
// key_sigh(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_sigh_test = cp.key_sigh(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_sigh license "MIT";
key_sigh(m) = _ilog4(m, 21, 0.013, 60, 0.010, 84, 0.007, 108, 0.004) * _h_width;


// Weight of the lower-middle register, peaking over A2..A3 and fading to
// zero at A1 and A4, for the two tone controls below.
_key_body(m) = _smooth01((m - 33.0) / 12.0) * _smooth01((69.0 - m) / 12.0);


//-----------------------------------`(cp.)key_fundg`-----------------------------------
// Gain of the first mode's radiation (`fundamental_boost_db` over the
// lower-middle register).
//
// #### Usage
//
// ```
// key_fundg(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_fundg_test = cp.key_fundg(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_fundg license "MIT";
key_fundg(m) = _db2lin(_t_fund * _key_body(m));

//-----------------------------------`(cp.)key_lowdb`-----------------------------------
// Depth in dB of the lower-overtone cut (`lower_overtone_cut_db` over the
// lower-middle register).
//
// #### Usage
//
// ```
// key_lowdb(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_lowdb_test = cp.key_lowdb(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_lowdb license "MIT";
key_lowdb(m) = _t_lowcut * _key_body(m);

//------------------------------------`(cp.)key_ns`-------------------------------------
// Number of unison strings: 1 below G1 (MIDI 31), 2 below F2 (41), 3 above.
//
// #### Usage
//
// ```
// key_ns(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_ns_test = cp.key_ns(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_ns license "MIT";
key_ns(m) = 1 + (m >= 31.0) + (m >= 41.0);

//----------------------------------`(cp.)key_damper`-----------------------------------
// 1 when the key has a damper (fundamental below 1400 Hz), 0 for the free top
// of the keyboard.
//
// #### Usage
//
// ```
// key_damper(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_damper_test = cp.key_damper(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_damper license "MIT";
key_damper(m) = key_f0(m) < 1400.0;

// Physical key index 0..87 (A0 = 0) of the per-key tables.
_key_index(m) = _clamp(0, 87, int(m + 0.5) - 21);

//-----------------------------------`(cp.)key_dsig`------------------------------------
// Decay rate (1/s) a seated damper imposes on the key's modes
// (`key_damp_sig`), its time scaled by `damper_scale`. A released mode decays
// at the larger of this rate and its own.
//
// #### Usage
//
// ```
// key_dsig(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// key_dsig_test = cp.key_dsig(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare key_dsig license "MIT";
key_dsig(m) = _LN1000 / _clamp(0.06 * _a_damper, 0.45 * _a_damper, _a_damper * 0.25 * pow(220.0 / key_f0(m), 0.3));


//==================================== Bridge voicing ====================================
// The empirical curves `piano.hpp` applies between a string mode and the bridge
// force: the register-dependent bridge EQ, the lower-overtone restraint, the treble
// tilt, and the longitudinal resonances of the phantom partials.
//========================================================================================

//---------------------------------`(cp.)bridge_trans`----------------------------------
// Bridge voicing gain of a component at `f` Hz for key `m` (`bridge_trans`):
// a piecewise dB curve from 250 Hz to 4 kHz at full strength up to A4 and gone
// by C5, a bass body contour fading out by G#3, the `mid_*` bell EQ, all
// scaled by `bridge_curve_scale`, times the register balance `key_strike_gain`.
//
// #### Usage
//
// ```
// bridge_trans(m, f) : _
// ```
//
// Where:
//
// * `m`: note number
// * `f`: frequency in Hz
//
// #### Test
// ```
// cp = library("coopiano.lib");
// bridge_trans_test = cp.bridge_trans(hslider("key", 60, 21, 108, 1), hslider("f", 440, 20, 10000, 1));
// ```
//----------------------------------------------------------------------------------------
declare bridge_trans license "MIT";
bridge_trans(m, f) = _db2lin(shaped) * key_strike_gain(m)
with {
    f0 = key_f0(m);
    sg(q0, d0, q1, d1) = (f > q0) * (f <= q1) * (d0 + log(f / q0) / log(q1 / q0) * (d1 - d0));
    db = sg(250, 0, 400, 1) + sg(400, 1, 600, 1) + sg(600, 1, 900, 2) + sg(900, 2, 1250, 2)
       + sg(1250, 2, 1700, 8) + sg(1700, 8, 2200, 3) + sg(2200, 3, 3000, 0) + sg(3000, 0, 4000, 0);
    s = _clamp(0.0, 1.0, log(523.25 / f0) / log(523.25 / 440.0));
    bass = _smooth01(_log2(mtof(56.0) / f0) / (16.0 / 12.0));
    low = _smooth01(_log2(400.0 / f) / _log2(400.0 / 150.0));
    mid = exp(-0.5 * pow(_log2(f / 850.0) / 0.7, 2.0));
    bell = _t_midg * exp(-0.5 * pow(_log2(f / _t_midf) / _t_midw, 2.0));
    shaped = (s * db * (1.0 - bass) + bass * (6.0 * low - 4.0 * mid)) * _t_curve + bell;
};

//----------------------------------`(cp.)lower_gain`-----------------------------------
// Broad restraint of the lower overtones between 160 Hz and 2 kHz
// (`lower_overtone_gain`), by `key_lowdb(m)` dB at its deepest. The first
// mode bypasses it.
//
// #### Usage
//
// ```
// lower_gain(m, f) : _
// ```
//
// Where:
//
// * `m`: note number
// * `f`: frequency in Hz
//
// #### Test
// ```
// cp = library("coopiano.lib");
// lower_gain_test = cp.lower_gain(hslider("key", 60, 21, 108, 1), hslider("f", 440, 20, 10000, 1));
// ```
//----------------------------------------------------------------------------------------
declare lower_gain license "MIT";
lower_gain(m, f) = _db2lin(-key_lowdb(m) * rise * fall)
with {
    rise = _smooth01(_log2(f / 160.0) / _log2(220.0 / 160.0));
    fall = _smooth01(_log2(2000.0 / f));
};

//----------------------------------`(cp.)treble_tilt`----------------------------------
// Treble tilt above `1.4 f0` (`treble_tilt`): up to 18 dB less on the
// upper partials of the keys above G5.
//
// #### Usage
//
// ```
// treble_tilt(m, f) : _
// ```
//
// Where:
//
// * `m`: note number
// * `f`: frequency in Hz
//
// #### Test
// ```
// cp = library("coopiano.lib");
// treble_tilt_test = cp.treble_tilt(hslider("key", 60, 21, 108, 1), hslider("f", 440, 20, 10000, 1));
// ```
//----------------------------------------------------------------------------------------
declare treble_tilt license "MIT";
treble_tilt(m, f) = _db2lin(-r * _clamp(0.0, 18.0, 12.0 * _log2(f / (1.4 * key_f0(m)))))
with { r = _smooth01(_log2(key_f0(m) / mtof(79.0)) * 12.0 / 5.0); };

//-----------------------------------`(cp.)long_gain`-----------------------------------
// Resonant boost near the string's longitudinal modes (`longitudinal_gain`):
// a Lorentzian of Q 25 and peak +4.6 at each multiple of `key_flong(m)` below
// 5 kHz. It scales a phantom partial at its sum frequency `f`.
//
// #### Usage
//
// ```
// long_gain(m, f) : _
// ```
//
// Where:
//
// * `m`: note number
// * `f`: frequency in Hz
//
// #### Test
// ```
// cp = library("coopiano.lib");
// long_gain_test = cp.long_gain(hslider("key", 60, 21, 108, 1), hslider("f", 440, 20, 10000, 1));
// ```
//----------------------------------------------------------------------------------------
declare long_gain license "MIT";
long_gain(m, f) = 1.0 + sum(j, 5, (fm(j) < 5000.0) * 4.6 * bw(j) * bw(j) / ((f - fm(j)) * (f - fm(j)) + bw(j) * bw(j)))
with {
    fm(j) = (j + 1) * key_flong(m);
    bw(j) = fm(j) / 50.0;
};

//----------------------------------`(cp.)middle_long`----------------------------------
// Amplitude of the longitudinal layer (`middle_longitudinal_scale`): full up to
// E2, 30 % at C3, none from G#3 on, with smooth fades between.
//
// #### Usage
//
// ```
// middle_long(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// middle_long_test = cp.middle_long(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare middle_long license "MIT";
middle_long(m) = select2(m <= 40.0, select2(mm < 48.0,
        0.3 * (1.0 - _smooth01((mm - 48.0) / 8.0)),
        1.0 - 0.7 * _smooth01((mm - 40.0) / 8.0)), 1.0) * (m < 56.0)
with { mm = 69.0 + 12.0 * _log2(key_f0(m) / 440.0); };

// Share of the slow polarization by partial number (`aftersound_share`): 0.35
// for the fundamental, 0.6 for the second partial, 1 above.
_aftersound(n) = select2(n == 1, select2(n == 2, 1.0, 0.6), 0.35);


//====================================== Mode slots ======================================
// Internal: what a mode slot needs, as functions of the note number `m` and the
// slot `k`. They reproduce `build_string`, `fast_polarization_decay` and
// `collect_phasors`; the voice computes them in its parameter domains.
//========================================================================================

// Slots per string, the slot's string and the slot's partial number (1-based).
_slot_per(m) = NS / key_ns(m);
_slot_s(m, k) = floor(k / _slot_per(m));
_slot_n(m, k) = k - _slot_s(m, k) * _slot_per(m) + 1;

// Fundamental of the slot's string, detuned by the key's tuning draw
// (`key_u` table) times the string's offset (-1.15, 0.1, 0.7) and `key_det`.
_slot_f0s(m, k) = key_f0(m) * pow(2.0, det / 1200.0)
with {
    s = _slot_s(m, k);
    u = tb.key_u, _key_index(m) * 3 + int(s) : rdtable;
    det = select3(int(s), -1.15, 0.1, 0.7) * key_det(m) * u;
};

// Stiff-string frequency of the partial, before the bridge's reactive pull.
_slot_fn0(m, k) = n * f0s * sqrt(1.0 + key_B(m) * n * n)
with { n = _slot_n(m, k); f0s = _slot_f0s(m, k); };

// 1 if the partial lies below 17.5 kHz (`F_LIMIT`) and below 0.45 fs.
_slot_exists(m, k) = (_slot_fn0(m, k) <= 17500.0) * (_slot_fn0(m, k) < 0.45 * ma.SR);

// Frequency of the mode, pulled by the admittance's imaginary part
// (`f0 Zs Im(Y) / pi`, times `bridge_coupling`).
_slot_fn(m, k) = fn0 + _s_coupling * _slot_f0s(m, k) * zs * _adm_im(fn0) / _PI
with {
    fn0 = _slot_fn0(m, k);
    zs = sqrt(key_T(m) * key_ms(m) / key_L(m));
};

// Late-stage decay rate of the mode: the fundamental's rate, the quadratic
// loss capped above 2.5 kHz, and a cubic term.
_slot_sig(m, k) = _LN1000 / key_T60(m) + key_c2(m) * (fn0 * fn0 - f0s * f0s) / (1.0 + fn0 / 2500.0)
    + 0.8 * pow(fn0 / 4000.0, 3.0)
with { fn0 = _slot_fn0(m, k); f0s = _slot_f0s(m, k); };

// Strike-point readout of the mode, `sin(n pi alpha)`, softened by the felt's
// width.
_slot_sa(m, k) = sin(n * _PI * key_alpha(m)) * exp(-0.5 * pow(n * _PI * key_sigh(m) / key_L(m), 2.0))
with { n = _slot_n(m, k); };

// Bridge weight of the mode, `T n pi / L (-1)^n` times the bridge voicing and the
// treble tilt: the phantom parent weight. `_slot_wbr` adds the fundamental gain
// or the lower-overtone cut.
_slot_pw(m, k) = key_T(m) * (n * _PI / key_L(m)) * select2(n - 2.0 * floor(n / 2.0) > 0.5, 1.0, -1.0)
    * bridge_trans(m, f) * treble_tilt(m, f)
with { n = _slot_n(m, k); f = _slot_fn(m, k); };
_slot_wbr(m, k) = _slot_pw(m, k) * select2(_slot_n(m, k) == 1, lower_gain(m, _slot_fn(m, k)), key_fundg(m));

// Two-stage decay (`collect_phasors`, `fast_polarization_decay`): the slow
// (horizontal) rate, with the treble tail extension and the upper-partial loss,
// and the prompt (vertical) rate, following the admittance's real part, with the
// fast strike-to-tail transition of the upper register.
_slot_sgh(m, k) = _slot_sig(m, k) * (1.0 - 0.45 * _top_tail(m) - 0.25 * _last_oct(m)) + _slot_loss(m, k);
_slot_sgv(m, k) = v1 + early_mix * max(0.0, early_rate - v1)
with {
    n0 = _slot_n(m, k) - 1;
    f = _slot_fn(m, k);
    base = _LN1000 / key_T60(m);
    ratio = _clamp(0.1, 8.0, 3.0 * _adm_re(f) / tb.adm_mean);
    prompt = base * key_fast(m) * select2((_s_coupling > 0.0) * (f < 12000.0), 1.0, pow(ratio, _s_coupling));
    v0 = prompt + max(0.0, _slot_sig(m, k) - base) * sqrt(key_fast(m));
    v1 = v0 + _slot_loss(m, k);
    high = _smooth01(_log2(key_f0(m) / mtof(76.0)) * 4.0);
    early_rate = select2(n0 == 0, 5.0 + 2.0 * min(n0, 3.0) + 3.0 * high, 10.0) * (1.0 + 0.6 * _last_oct(m));
    early_mix = select2(n0 == 0, _upper(m), high);
};

// Extra loss of the upper partials above C5.
_slot_loss(m, k) = _upper(m) * 0.6 * min(_slot_n(m, k) - 1, 3.0);

// Amplitude share of the slow polarization (`aftersound_share`, softened above
// C5).
_slot_share(m, k) = _s_hratio * _aftersound(n) * (1.0 + _upper(m) * (tail - 1.0))
with {
    n = _slot_n(m, k);
    high = _smooth01(_log2(key_f0(m) / mtof(76.0)) * 4.0);
    tail = select2(n == 1, select2(n == 2, 0.75 - 0.25 * high, 0.85 - 0.20 * high), 1.0);
};

// Register fades over C6..F#6, C7..C8 and C5..E5.
_top_tail(m) = _smooth01(_log2(key_f0(m) / mtof(84.0)) * 2.0);
_last_oct(m) = _smooth01(_log2(key_f0(m) / mtof(96.0)));
_upper(m) = _smooth01(_log2(key_f0(m) / mtof(72.0)) * 3.0);

// Deterministic draw in [-1, 1) per key and slot: the slow polarization's
// hair of detune (the C++ draws it from a per-key generator).
_hash(m, k) = 2.0 * ma.frac(sin(int(m + 0.5) * 12.9898 + k * 78.233 + 0.5) * 43758.5453) - 1.0;


//================================ Resonators and hammer =================================
// The building blocks of the voice: the force gains of a mode over one sample with
// a first-order hold, the mode as a complex one-pole resonator, and the implicit
// solve of the felt law.
//========================================================================================

// phi1(x) = (e^x - 1)/x and phi2(x) = (e^x - 1 - x)/x^2 at complex x = (xr, xi),
// the first-order-hold integrals of exponential integrators, by their Taylor
// series near 0. Outputs Re phi1, Im phi1, Re phi2, Im phi2.
_phis(xr, xi) = sel(p1r, t1r), sel(p1i, t1i), sel(p2r, t2r), sel(p2i, t2i)
with {
    n2 = xr * xr + xi * xi;
    sel(a, b) = select2(n2 < 1.0e-4, a, b);
    er = exp(xr) * cos(xi) - 1.0;
    ei = exp(xr) * sin(xi);
    d = max(n2, 1.0e-300);
    p1r = (er * xr + ei * xi) / d;
    p1i = (ei * xr - er * xi) / d;
    p2r = ((p1r - 1.0) * xr + p1i * xi) / d;
    p2i = (p1i * xr - (p1r - 1.0) * xi) / d;
    x2r = xr * xr - xi * xi;
    x2i = 2.0 * xr * xi;
    x3r = x2r * xr - x2i * xi;
    x3i = x2r * xi + x2i * xr;
    t1r = 1.0 + xr / 2.0 + x2r / 6.0 + x3r / 24.0;
    t1i = xi / 2.0 + x2i / 6.0 + x3i / 24.0;
    t2r = 0.5 + xr / 6.0 + x2r / 24.0 + x3r / 120.0;
    t2i = xi / 6.0 + x2i / 24.0 + x3i / 120.0;
};

//----------------------------------`(cp.)force_gains`----------------------------------
// Force gains of a mode over one sample with a first-order hold. A mode
// `q'' + 2 sigma q' + (w^2 + sigma^2) q = g F(t)` is written `z = q - i (q' + sigma q)/w`
// (`Re z` is the displacement); with `F` linear between two samples,
// `z[n] = lambda z[n-1] + G0 F[n-1] + G1 F[n]`, `lambda = exp((-sigma + i w) T)`.
// The recursion is exact for a piecewise-linear force. Outputs Re G0, Im G0,
// Re G1, Im G1.
//
// #### Usage
//
// ```
// force_gains(sigma, w, g) : _,_,_,_
// ```
//
// Where:
//
// * `sigma`: decay rate of the mode (1/s)
// * `w`: angular frequency (rad/s)
// * `g`: coupling of the force to the mode (`2 / m_s` times the strike-point readout)
//
// #### Test
// ```
// cp = library("coopiano.lib");
// ma = library("maths.lib");
// force_gains_test = cp.force_gains(3, 2 * ma.PI * 440, 0.1);
// ```
//
// #### References
//
// * M. Hochbruck, A. Ostermann, Exponential integrators, Acta Numerica 19, 2010
//----------------------------------------------------------------------------------------
declare force_gains license "MIT";
force_gains(sigma, w, g) = _T * c * (p1i - p2i), -_T * c * (p1r - p2r), _T * c * p2i, -_T * c * p2r
with {
    c = g / w;
    p1r = _phis(-sigma * _T, w * _T) : _, !, !, !;
    p1i = _phis(-sigma * _T, w * _T) : !, _, !, !;
    p2r = _phis(-sigma * _T, w * _T) : !, !, _, !;
    p2i = _phis(-sigma * _T, w * _T) : !, !, !, _;
};

//-------------------------------------`(cp.)mode`--------------------------------------
// A mode as its free prediction `w[n] = lambda z[n-1] + G0 F[n-1]`, the state at `n`
// before the force `F[n]` acts (so `z[n] = w[n] + G1 F[n]`). It obeys
// `w[n] = lambda w[n-1] + (lambda G1 + G0) F[n-1]`: the strike-point
// displacement, the bridge force and the phantoms read it without extra work.
// `r` carries the damper (the per-sample radius blends the open and the seated
// decay). Outputs Re w and Im w.
//
// #### Usage
//
// ```
// mode(r, cs, sn, gr, gi, u) : _,_
// ```
//
// Where:
//
// * `r`: per-sample radius `exp(-sigma T)`
// * `cs`: `cos(w T)`
// * `sn`: `sin(w T)`
// * `gr`: real part of `lambda G1 + G0`
// * `gi`: imaginary part of `lambda G1 + G0`
// * `u`: the force one sample late, `F[n-1]`
//
// #### Test
// ```
// cp = library("coopiano.lib");
// mode_test = cp.mode(0.9999, cos(0.0627), sin(0.0627), 0.001, 0.0, button("strike"));
// ```
//----------------------------------------------------------------------------------------
declare mode license "MIT";
mode(r, cs, sn, gr, gi, u) = loop ~ (_, _)
with {
    loop(wr, wi) = r * (cs * wr - sn * wi) + gr * u,
                   r * (sn * wr + cs * wi) + gi * u;
};

//----------------------------------`(cp.)felt_solve`-----------------------------------
// Compression `d` in `(0, a]` that solves `d + C d^p / (1 + E d^p) = a`: the felt law
// `F = K d^p (1 + 0.12 d')` with the compression rate taken at the same sample,
// against the strings' and the hammer's direct responses to the current force.
// Newton from the smaller of the two one-term solutions, which lies above the
// root, kept in `[d/2, a]`; five steps reach the C++ contact to 1e-3
// (`scripts/contact_sim.py`).
//
// #### Usage
//
// ```
// felt_solve(a, C, E, p) : _
// ```
//
// Where:
//
// * `a`: free compression (hammer minus string, without the current force)
// * `C`: direct response times the felt's power-law gain (`c A`)
// * `E`: hysteresis term of the felt's rate (`0.12 d1 K ns`)
// * `p`: exponent of the felt's power law
//
// #### Test
// ```
// cp = library("coopiano.lib");
// felt_solve_test = cp.felt_solve(hslider("a", 1e-4, 1e-6, 1e-3, 1e-6), 1e9, 1e3, 3.0);
// ```
//
// #### References
//
// * A. Stulov, Hysteretic model of the grand piano hammer felt, JASA 97(4), 1995
// * G. Borin, G. De Poli, D. Rocchesso, Elimination of delay-free loops in discrete-time models of nonlinear acoustic systems, IEEE TSAP 8(5), 2000
//----------------------------------------------------------------------------------------
declare felt_solve license "MIT";
felt_solve(a, C, E, p) = it(5, d0)
with {
    aa = max(a, 1.0e-30);
    d0 = min(aa, pow(aa / max(C, 1.0e-300), 1.0 / p));
    it(0, d) = d;
    it(N, d) = it(N - 1, min(aa, max(0.5 * d, d - (d + C * dp / den - aa) / (1.0 + C * p * dp / (d * den * den)))))
    with { dp = pow(d, p); den = 1.0 + E * dp; };
};


//=================================== Voice internals ====================================
// Internal: the parameters of a voice, computed in `ondemand` domains when the
// note or the voicing changes, and the audio-rate boxes that use them. The voice
// is written as dataflow (each slot a box evaluated once, its signals routed to the
// sums and the phantom pairs). That was the way around faust-rs re-evaluating a
// function called in a lambda at every application (faust-rs-issues/RAPPORT.md,
// point 1), which faust-rs no longer does since 2026-10-16; the dataflow form is
// kept, checked and as quick to compile.
//========================================================================================

// One polarization `P` (0 vertical/prompt, 1 horizontal/slow) of slot `k`:
// its decay rate, angular frequency (the slow one detuned by a hair), force
// coupling (the unison shares the force equally) and seated-damper rate.
_pol_sigma(m, k, P) = select2(P, _slot_sgv(m, k), _slot_sgh(m, k));
_pol_omega(m, k, P) = 2.0 * _PI * _slot_fn(m, k) * select2(P, 1.0, 1.0 + 2.5e-6 * (1.0 + 0.8 * _hash(m, k)));
_pol_coup(m, k, P) = _slot_exists(m, k) * 2.0 / key_ms(m) * _slot_sa(m, k) / key_ns(m)
    * select2(P, 1.0, _slot_share(m, k)) / (1.0 + _slot_share(m, k));
_pol_rsig(m, k, P) = max(key_dsig(m), _pol_sigma(m, k, P));

// Parameters of one polarization: open radius, seated radius, rotation,
// `lambda G1 + G0`, rate and frequency.
_NPOL = 8;
_pol_params(m, k, P) = force_gains(sig, w, cpl) : \(g0r, g0i, g1r, g1i).(
    ro, exp(-_pol_rsig(m, k, P) * _T), cs, sn, ro * (cs * g1r - sn * g1i) + g0r, ro * (sn * g1r + cs * g1i) + g0i, sig, w)
with {
    sig = _pol_sigma(m, k, P);
    w = _pol_omega(m, k, P);
    cpl = _pol_coup(m, k, P);
    ro = exp(-sig * _T);
    cs = cos(w * _T);
    sn = sin(w * _T);
};

// Direct gains of `F[n]` on the strike-point displacement and velocity.
_pol_direct(m, k, P) = force_gains(_pol_sigma(m, k, P), _pol_omega(m, k, P), _pol_coup(m, k, P))
    : \(g0r, g0i, g1r, g1i).(g1r, -_pol_sigma(m, k, P) * g1r - _pol_omega(m, k, P) * g1i);

// Parameters of one slot: both polarizations, the strike-point weight averaged
// over the unison, the bridge weight, the string index and its readout
// asymmetry (`prepare_readout`: bichords get a fixed 25 % split).
_NSP = 2 * _NPOL + 4;
_slot_params(m, k) = _pol_params(m, k, 0), _pol_params(m, k, 1), _slot_sa(m, k) / key_ns(m), _slot_wbr(m, k), s, asym
with {
    s = _slot_s(m, k);
    asym = select2(key_ns(m) == 2, 0.0, select2(s < 0.5, -0.25, 0.25));
};

// Coefficient of the phantom pair (slot k, slot k + d) of one string
// (`add_phantoms`), without the string's per-strike readout: the pair's
// weight 0.55^d, the parents' bridge weights, the bridge voicing, longitudinal
// resonance and lower-overtone cut at the sum frequency, the softening above
// 1 kHz; zero unless both parents lie below 3.5 kHz and their sum below 4.2 kHz.
_pair_coef(m, k, d) = valid * _s_long * pow(0.55, d) * qn(k) * qn(j) * bridge_trans(m, f) * long_gain(m, f)
    * lower_gain(m, f) * (1.0 - 0.75 * _smooth01((f - 500.0) / 500.0))
with {
    j = min(k + d, NS - 1);
    f = _slot_fn(m, k) + _slot_fn(m, j);
    qn(i) = _slot_pw(m, i) / bridge_trans(m, _slot_fn(m, i));
    ok(i) = _slot_exists(m, i) * (_slot_fn(m, i) < 3500.0);
    valid = (k + d < NS) * ok(k) * ok(j) * (_slot_s(m, k) == _slot_s(m, j)) * (f <= 4200.0) * (m < 56.0);
};

// Bound constant of the same pair (`bound_phantom`). With a parent's amplitude
// a = readout x parent weight x state, the pair's excitation over its limit,
// 0.65 sqrt(|a_k| |a_j|), is this constant times |readout| sqrt(|w_k| |w_j|),
// w the two states: the bridge voicing at the sum over the parents', and the
// parents' weights. Zero where a slot is missing (its factor is then 1).
_pair_bound(m, k, d) = select2(valid, 0.0, _s_long * pow(0.55, d) * bridge_trans(m, fk + fj)
    / (bridge_trans(m, fk) * bridge_trans(m, fj)) * sqrt(abs(_slot_pw(m, k) * _slot_pw(m, j))) / 0.65)
with {
    j = min(k + d, NS - 1);
    fk = _slot_fn(m, k);
    fj = _slot_fn(m, j);
    valid = (k + d < NS) * _slot_exists(m, k) * _slot_exists(m, j);
};

// Phantom pairs and the size of the parameter bus.
_NPAIR = NP * (DMAX + 1);
_NPAR = _NSP * NS + 2 * _NPAIR + 2;

// The voice's parameters in ondemand domains of eight slots, clocked by `chg`,
// the note held at the change: the slots, the phantom coefficients, their bound
// constants, and the strike point's two direct gains summed over the slots.
_voice_params_on(chg, m) = par(c, NS / 8, on_change(chg, m, \(mm).(par(i, 8, _slot_params(mm, 8 * c + i))))),
    par(c, NP / 8, on_change(chg, m, \(mm).(par(i, 8, par(d, DMAX + 1, _pair_coef(mm, 8 * c + i, d)))))),
    par(c, NP / 8, on_change(chg, m, \(mm).(par(i, 8, par(d, DMAX + 1, _pair_bound(mm, 8 * c + i, d)))))),
    (par(c, NS / 8, on_change(chg, m, \(mm).(_direct_part(mm, c)))) :> _, _);
_direct_part(m, c) = sum(i, 8, ya(8 * c + i) * (dsp(8 * c + i, 0) + dsp(8 * c + i, 1))),
                    sum(i, 8, ya(8 * c + i) * (dvl(8 * c + i, 0) + dvl(8 * c + i, 1)))
with {
    ya(k) = _slot_sa(m, k) / key_ns(m);
    dsp(k, P) = _pol_direct(m, k, P) : _, !;
    dvl(k, P) = _pol_direct(m, k, P) : !, _;
};

// Change detector of the voicing controls the parameters read.
_voicing_hash = _h_stiffness * 1.1 + _h_mass * 1.3 + _h_width * 1.7 + _h_vmax * 1.9 + _h_vexp * 2.3
    + _s_decay * 2.9 + _s_treble_decay * 3.1 + _s_loss * 3.7 + _s_inharm * 4.1 + _s_detune * 4.3
    + _s_treble_detune * 4.7 + _s_fast * 5.3 + _s_hratio * 5.9 + _s_long * 6.1 + _s_coupling * 6.7
    + _t_fund * 7.1 + _t_lowcut * 7.3 + _t_curve * 7.9 + _t_midg * 8.3 + _t_midf * 8.9e-3 + _t_midw * 9.7
    + _a_damper * 10.1;


// One polarization at the audio rate: its parameters, the damper position
// `dmp` and the force `u = F[n-1]`; outputs Re w, Im w and the free velocity.
_polbox(dmp) = \(ro, rdd, cs, sn, gr, gi, sig, w, u).(
    mode(ro + dmp * (rdd - ro), cs, sn, gr, gi, u) : \(wr, wi).(wr, wi, -sig * wr - w * wi));

// One slot at the audio rate: its NSP parameters then `u`. SLOT_OUT outputs:
// the strike point's free displacement and velocity (weighted), the bridge
// force, Re/Im of the vertical then horizontal states, the string's readout
// gain. The first NSUM are summed over the slots.
_SLOT_OUT = 8;
_NSUM = 3;
_slotbox(dmp, r0, r1, r2) = route(_NSP + 1, 2 * (_NPOL + 1) + 4,
        par(i, _NPOL, (i + 1, i + 1)), (_NSP + 1, _NPOL + 1),
        par(i, _NPOL, (_NPOL + i + 1, _NPOL + 1 + i + 1)), (_NSP + 1, 2 * _NPOL + 2),
        par(i, 4, (2 * _NPOL + 1 + i, 2 * _NPOL + 3 + i)))
    : (_polbox(dmp), _polbox(dmp), _, _, _, _)
    : \(wr0, wi0, ve0, wr1, wi1, ve1, ya, wbr, s, asym).(
        ya * (wr0 + wr1), ya * (ve0 + ve1), rd(s, asym) * wbr * (wr0 + wr1), wr0, wi0, wr1, wi1, rd(s, asym))
with {
    // Readout gain of string s (prepare_readout): r0..r2 are the per-strike
    // uniform draws in [-1, 1].
    rd(s, asym) = (1.0 + _s_hratio) * (1.0 + asym + 0.13 * select3(int(s), r0, r1, r2));
};


// Phantom partials at the audio rate: each pair reads the states of its two
// slots, the readout of the first, its coefficient and its two bound factors
// (vertical, horizontal; see `_phantom_gains`). `_cre` is Re(a b)
// written without squares: `x*x` became a pow call before faust-rs 2026-10-16
// (point 4 of the faust-rs report); the form is kept, it costs no more. Only
// keys below G#3 have phantoms: the pairs run in an
// ondemand domain clocked by that condition, and a stopped domain's held
// output is masked.
_phantom_route = route(_SLOT_OUT * NS + 3 * _NPAIR, 12 * _NPAIR, par(q, 12 * _NPAIR, (src(q) + 1, q + 1)))
with {
    src(q) = select2(e < 8, select2(e == 8, select2(e == 9, _SLOT_OUT * NS + _NPAIR + 2 * pr + e - 10,
                                                    _SLOT_OUT * NS + pr), _SLOT_OUT * k + 7),
                     _SLOT_OUT * select2(e < 4, j, k) + 3 + e % 4)
    with {
        pr = int(q / 12);
        e = q % 12;
        k = int(pr / (DMAX + 1));
        j = min(k + pr % (DMAX + 1), NS - 1);
    };
};
_cre(ar, ai, br, bi) = (ar - ai) * (br + bi) + ai * br - ar * bi;
_phantom_pair = \(vri, vii, hri, hii, vrj, vij, hrj, hij, rd, cv, gv, gh).(
    cv * rd * rd * (gv * _cre(vri, vii, vrj, vij) + gh * _cre(hri, hii, hrj, hij)));
_phantom_sum = _phantom_route : par(pr, _NPAIR, _phantom_pair) : gsum(_NPAIR, 32);
_phantoms(m) = (on, si.bus(_SLOT_OUT * NS + 3 * _NPAIR)) : ondemand(_phantom_sum) : *(on * middle_long(m))
with { on = m < 56.0; };

// Bound factors of the phantom pairs (`bound_phantom`): `piano.hpp` scales each
// pair's excitation by (1 + r^8)^(-1/8), r its ratio to 0.65 sqrt(|a_k| |a_j|),
// once per strike, from the parents' amplitudes when the contact hands over to
// the strings. A quadratic pair then grows like its parents' geometric mean
// instead of their product: at fortissimo in the wound bass it would otherwise
// outgrow the partials driving it. Inputs: the slot outputs and the pairs' bound
// constants (`_pair_bound`); outputs the vertical and the horizontal factor of
// each pair. Only the five slot outputs it reads enter the domain. (A faust-rs
// older than `ccca27eb`, 2026-10-17, rejects `dsp/coopiano_hammer.dsp` here:
// FRS-FIR-0001 "use of undeclared variable", point 16 of the faust-rs report.)
_slot_mags = \(vr, vi, hr, hi, rd).(abs(rd) * sqrt(vr * vr + vi * vi), abs(rd) * sqrt(hr * hr + hi * hi));
_gain_route = route(2 * NS + _NPAIR, 5 * _NPAIR, par(q, 5 * _NPAIR, (src(q) + 1, q + 1)))
with {
    // per pair: |a_k| and |a_j| vertical, then horizontal, then the constant
    src(q) = select2(e == 4, 2 * select2(e % 2 == 1, k, j) + int(e / 2), 2 * NS + pr)
    with {
        pr = int(q / 5);
        e = q % 5;
        k = int(pr / (DMAX + 1));
        j = min(k + pr % (DMAX + 1), NS - 1);
    };
};
_bound_factor(r) = pow(1.0 + r4 * r4, -0.125) with { r2 = r * r; r4 = r2 * r2; };
_pair_gains = \(avk, avj, ahk, ahj, kb).(_bound_factor(kb * sqrt(avk * avj)), _bound_factor(kb * sqrt(ahk * ahj)));
_phantom_gains = (par(k, NS, _slot_mags), si.bus(_NPAIR)) : _gain_route : par(pr, _NPAIR, _pair_gains);

// The phantoms of one voice. Inputs: the slot outputs, the pair coefficients and
// bound constants, the strike point's two direct gains and the hammer force;
// outputs the phantoms' bridge force, then the direct gains and the force.
// The bound factors run in an ondemand domain clocked by `win`, the first 30 ms
// after a strike: they follow the parents through the contact (24 ms at most
// below G#3, A0 at the lowest velocity) and hold the amplitudes the strings keep
// after it. Before a voice's first strike they are zero, as are its phantoms.
_phantom_block(m, win) = (si.bus(S) <: si.bus(2 * S)), si.bus(2 * _NPAIR), _, _, _
    : route(T, T, par(i, S, (i + 1, i + 1)),
                  par(i, _NPAIR, (2 * S + i + 1, S + i + 1)),
                  par(i, S, (S + i + 1, S + _NPAIR + i + 1)),
                  par(i, _NPAIR + 3, (2 * S + _NPAIR + i + 1, 2 * S + _NPAIR + i + 1)))
    : (si.bus(S + _NPAIR), ((win * on), par(k, NS, (!, !, !, si.bus(5))), si.bus(_NPAIR) : ondemand(_phantom_gains)), _, _, _)
    : (_phantoms(m), _, _, _)
with {
    S = _SLOT_OUT * NS;
    T = 2 * S + 2 * _NPAIR + 3;
    on = m < 56.0;
};


// The hammer (`run_contact`, solved implicitly). State at n-1: position,
// velocity, touched, active; output F[n]. Inputs: the strike point's free
// displacement and velocity at n, their direct gains `rs` and `rv`, F[n-1] and
// the trigger. Compression and rate are taken at n; a strike starts the hammer
// at the string, at the key's speed `maximum_velocity_mps * v^velocity_exponent`;
// it separates when it moves away after a contact.
_hammer(m, v, ysf, ydf, rs, rv, u, trig) = (ysf, ydf, u, trig) : (step ~ si.bus(4)) : !, !, !, !, _
with {
    mh = key_mh(m);
    p = key_p(m);
    ns = key_ns(m);
    v0 = _h_vmax * pow(v, _h_vexp);
    step(yh, vh, tc, ac, ysf, ydf, uu, tr) = yh1, vh1, tc1, ac1, F
    with {
        vh0 = select2(tr, vh, v0);
        yh0 = select2(tr, yh, ysf - _T * vh0);
        tc0 = select2(tr, tc, 0.0);
        ac0 = select2(tr, ac, 1.0);
        yfree = yh0 + _T * vh0 - _T * _T * uu / (3.0 * mh);
        a = yfree - ysf;
        // compression rate at n: d0 - d1 F
        d0 = vh0 - _T * uu / (2.0 * mh) - ydf;
        d1 = _T / (2.0 * mh) + rv;
        A = key_K(m) * ns * max(0.0, 1.0 + 0.12 * d0) * ac0;
        E = 0.12 * d1 * key_K(m) * ns * ac0;
        contact = (a > 0.0) * (A > 0.0);
        d = felt_solve(a, (_T * _T / (6.0 * mh) + rs) * A, E, p);
        F = contact * A * pow(d, p) / (1.0 + E * pow(d, p));
        vh1 = vh0 - _T * (uu + F) / (2.0 * mh);
        yh1 = yfree - _T * _T * F / (6.0 * mh);
        tc1 = max(tc0, contact);
        ac1 = ac0 * (1.0 - tc1 * (1.0 - contact) * (vh1 < 0.0));
    };
};


//==================================== Action noises =====================================
// The non-string sounds of a strike and a release (`prep_note_into`): keybed
// thump, structural knock of the upper keys, felt scrape, treble knock and
// damper felt, with the C++ filters and envelopes on Faust noise. Their level
// follows `tone_peak`, the excitation the contact gave the strings.
//========================================================================================

//------------------------------------`(cp.)noises`-------------------------------------
// Action noises of key `m` struck at velocity `v`: the thump (12 ms pulse and
// filtered noise, restrained above mezzo-forte in the bass), the structural
// knock (five damped resonances, 89 to 277 Hz, for the keys above G#4), the felt
// scrape (25 ms band-passed noise), the treble knock, and on release the damper
// felt brushing the string (30 ms) for the keys with dampers.
//
// #### Usage
//
// ```
// noises(m, v, gate, trig) : _
// ```
//
// Where:
//
// * `m`: note number
// * `v`: velocity in [0.02, 1]
// * `gate`: key down (1) or up (0)
// * `trig`: strike trigger, the rising edge of the gate
//
// #### Test
// ```
// cp = library("coopiano.lib");
// noises_test = cp.noises(hslider("key", 60, 21, 108, 1), hslider("velocity", 0.5, 0.02, 1, 0.001), g, g > g') with { g = button("gate"); };
// ```
//----------------------------------------------------------------------------------------
declare noises license "MIT";
noises(m, v, gate, trig) = knock + structural + scrape + treble + damper_noise
with {
    f0 = key_f0(m);
    tp = tone_peak(m, v);
    started = max(trig) ~ _;
    g(i) = no.multinoise(8) : ba.selector(i, 8) : *(sqrt(3.0));
    age = (+(1) : *(1 - trig)) ~ _;
    t = age / ma.SR;
    lp1(a, x) = x : fi.pole(_pole44(a)) : *(1.0 - _pole44(a));
    win(len) = started * (age < len);

    kvel = v + _clamp(0.0, 1.0, _log2(880.0 / f0)) * (min(v, 0.5) + 0.12 * ma.tanh(max(0.0, v - 0.5) / 0.12) - v);
    gain = 2.2 * _a_knock * tp * kvel;
    tk = _smooth01(_log2(f0 / mtof(84.0)));
    top = _smooth01(_log2(f0 / mtof(96.0)));
    klen = int(0.012 * ma.SR);
    x = age / klen;
    lpb = g(3) : lp1(0.92) : lp1(0.92);
    knock = win(klen) * gain * (1.0 + 0.8 * tk * (1.0 - top))
          * (pow(sin(_PI * x), 2.0) + 3.4 * lpb * sin(_PI * x));

    body = _smooth01(_log2(f0 / mtof(68.0)) * 1.5);
    fq = (89.0, 117.0, 163.0, 231.0, 277.0);
    wt = (1.0, 0.65, 0.32, 0.20, 0.28);
    partial(j) = (\(sr, si).(select2(trig, lr * sr - li * si, 1.0), select2(trig, li * sr + lr * si, 0.0))) ~ (_, _)
                 : !, *(ba.take(j + 1, wt))
    with {
        fj = ba.take(j + 1, fq);
        dj = 8.0 + 0.01 * fj;
        lr = exp(-dj * _T) * cos(2.0 * _PI * fj * _T);
        li = exp(-dj * _T) * sin(2.0 * _PI * fj * _T);
    };
    rise = 1.0 - exp(-t / 0.003);
    endf = _clamp(0.0, 1.0, (0.65 - t) / 0.04);
    structural = win(int(0.65 * ma.SR)) * 0.20 * body * gain * rise * rise * endf * endf * sum(j, 5, partial(j));

    slen = int(0.025 * ma.SR);
    ts = age / slen;
    hp = g(4) : lp1(0.45) : fi.zero(1) : fi.pole(_pole44(0.93));
    scrape = win(slen) * 0.011 * tp * pow(v, 1.8) * hp * exp(-7.0 * ts) * (1.0 - exp(-40.0 * ts));

    mc = g(5) : lp1(0.8) : lp1(0.8) : lp1(0.8);
    treble = win(klen) * 11.0 * tk * gain * (1.0 - exp(-t / 0.0015)) * exp(-t / 0.004) * mc;

    rel = (gate == 0) * (gate' > 0);
    rage = (+(1) : *(1 - rel)) ~ _;
    dlen = int(0.030 * ma.SR);
    rt = rage / dlen;
    rstarted = max(rel) ~ _;
    dgain = 0.0035 * tp * (0.4 + 0.6 * v) * _clamp(0.5, 1.4, pow(261.0 / f0, 0.3));
    damper_noise = key_damper(m) * rstarted * (rage < dlen) * (gate == 0) * dgain
                 * (g(6) : lp1(0.85)) * exp(-4.0 * rt) * (1.0 - exp(-25.0 * rt));
};

//-----------------------------------`(cp.)tone_peak`-----------------------------------
// Excitation level of the strings after contact (`tone_peak_amp`), which scales
// every action noise. Only the C++ contact solve gives it: the table
// `tb.tp_log` holds it for the 88 keys and 25 velocities (mean of four seeds,
// default voicing); it is read log-linearly in velocity at the nearest key.
//
// #### Usage
//
// ```
// tone_peak(m, v) : _
// ```
//
// Where:
//
// * `m`: note number
// * `v`: velocity in [0.02, 1]
//
// #### Test
// ```
// cp = library("coopiano.lib");
// tone_peak_test = cp.tone_peak(hslider("key", 60, 21, 108, 1), hslider("velocity", 0.5, 0.02, 1, 0.001));
// ```
//----------------------------------------------------------------------------------------
declare tone_peak license "MIT";
tone_peak(m, v) = pow(10.0, l0 + (jf - j0) * (l1 - l0))
with {
    nv = tb.tp_nv;
    jf = _clamp(0.0, nv - 1.0, log(v / 0.02) / log(50.0) * (nv - 1.0));
    j0 = min(int(jf), nv - 2);
    base = _key_index(m) * nv;
    l0 = tb.tp_log, base + j0 : rdtable;
    l1 = tb.tp_log, base + j0 + 1 : rdtable;
};


//======================================== Voice =========================================
// One key of the piano: hammer, strings, phantoms, action noises and damper, as
// the bridge force of the key (the units of `render_bridge_force`).
//========================================================================================

//-------------------------------------`(cp.)voice`-------------------------------------
// One key: the bridge force of key `m` struck at velocity `vel` while `gate` is
// down, and damped when it is released (unless the sustain pedal holds the
// dampers). The per-strike draws of the unison readout are sampled at the strike.
//
// #### Usage
//
// ```
// voice(m, vel, gate) : _
// ```
//
// Where:
//
// * `m`: note number, fractional allowed (`freq2m` converts a frequency)
// * `vel`: velocity in [0.02, 1] (MIDI velocity / 127)
// * `gate`: key down (1) or up (0)
//
// #### Test
// ```
// cp = library("coopiano.lib");
// voice_test = cp.voice(hslider("key", 60, 21, 108, 1), hslider("velocity", 0.5, 0.02, 1, 0.001), button("gate"));
// ```
//
// #### References
//
// * coopiano `piano.hpp`: `render_bridge_force`, `prep_note_into`, `collect_phasors`
//----------------------------------------------------------------------------------------
declare voice license "MIT";
voice(m, vel, gate) = voice_force(m, vel, gate) : !, _;

//----------------------------------`(cp.)voice_force`----------------------------------
// `voice` with the hammer force first: the force on all the strings (N), then the
// bridge force. For contact studies (`dsp/coopiano_hammer.dsp`).
//
// #### Usage
//
// ```
// voice_force(m, vel, gate) : _,_
// ```
//
// Where:
//
// * `m`: note number
// * `vel`: velocity in [0.02, 1]
// * `gate`: key down (1) or up (0)
//
// #### Test
// ```
// cp = library("coopiano.lib");
// voice_force_test = cp.voice_force(hslider("key", 60, 21, 108, 1), hslider("velocity", 0.5, 0.02, 1, 0.001), button("gate"));
// ```
//----------------------------------------------------------------------------------------
declare voice_force license "MIT";
voice_force(m, vel, gate) = voice_drawn(m, vel, gate, r(0), r(1), r(2))
with {
    // Per-strike draws of the unison readout spread (prepare_readout),
    // uniform in [-1, 1], held from the strike.
    r(i) = no.multinoise(8) : ba.selector(i, 8) : ba.sAndH(gate > gate');
};

//----------------------------------`(cp.)voice_drawn`----------------------------------
// The voice with given per-strike draws of the unison readout spread
// (`prepare_readout`: each string's bridge readout is scaled by `1 + 0.13 r`).
// `piano.hpp` draws them from the strike's seed; giving the seed's draws makes
// the Faust voice comparable with a C++ render (seed 1: -0.732, -0.727, -0.098).
// Outputs the hammer force and the bridge force.
//
// The parameters of the voice are recomputed only when the note or the voicing
// changes; the damper moves over 40 ms toward its target (seated after release,
// lifted by the pedal) and a strike lifts it at once.
//
// #### Usage
//
// ```
// voice_drawn(m, vel, gate, r0, r1, r2) : _,_
// ```
//
// Where:
//
// * `m`: note number
// * `vel`: velocity in [0.02, 1]
// * `gate`: key down (1) or up (0)
// * `r0`: draw of string 0, in [-1, 1]
// * `r1`: draw of string 1
// * `r2`: draw of string 2
//
// #### Test
// ```
// cp = library("coopiano.lib");
// voice_drawn_test = cp.voice_drawn(hslider("key", 60, 21, 108, 1), hslider("velocity", 0.5, 0.02, 1, 0.001), button("gate"), -0.732, -0.727, -0.098);
// ```
//----------------------------------------------------------------------------------------
declare voice_drawn license "MIT";
voice_drawn(m, vel, gate, r0, r1, r2) = params : (core ~ _)
with {
    v = _clamp(0.02, 1.0, vel);
    trig = gate > gate';
    // Damper position 0 (open) .. 1 (seated), moving over 40 ms; a strike lifts it.
    target = key_damper(m) * (gate == 0) * damper_contact(_pedal);
    // The first 30 ms after a strike (the phantoms' bound follows the contact).
    win = ((+(1) : *(1 - trig)) ~ _) < 0.030 * ma.SR;
    dmp = (\(d).(select2(trig, d + _clamp(-st, st, target - d), 0.0))) ~ _
    with { st = 1.0 / (0.040 * ma.SR); };
    // The parameters, recomputed only when the note or the voicing changes:
    // the note enters an ondemand domain as a held audio-rate signal, so the
    // whole computation stays inside the domain's tick (faust-rs).
    chg = (m != m') | (_voicing_hash != _voicing_hash');
    params = _voice_params_on(chg, m);
    // Slot k takes its NSP parameters and u.
    spread = route(1 + _NPAR, (_NSP + 1) * NS + 2 * _NPAIR + 3,
        par(o, (_NSP + 1) * NS, (select2(o % (_NSP + 1) == _NSP, 1 + _NSP * int(o / (_NSP + 1)) + o % (_NSP + 1), 0) + 1, o + 1)),
        par(i, 2 * _NPAIR + 2, (1 + _NSP * NS + i + 1, (_NSP + 1) * NS + i + 1)),
        (1, (_NSP + 1) * NS + 2 * _NPAIR + 3));
    sums = route(_SLOT_OUT * NS, _NSUM * NS, par(o, _NSUM * NS, (_SLOT_OUT * (o % NS) + int(o / NS) + 1, o + 1)))
         : par(f, _NSUM, gsum(NS, 32));
    core = spread : (par(k, NS, _slotbox(dmp, r0, r1, r2)), si.bus(2 * _NPAIR), _, _, _)
         : (si.bus(_SLOT_OUT * NS) <: (sums, si.bus(_SLOT_OUT * NS))), si.bus(2 * _NPAIR), _, _, _
         : _, _, _, _phantom_block(m, win)
         : \(ysf, ydf, br, ph, rs, rv, u).(_hammer(m, v, ysf, ydf, rs, rv, u, trig),
                                          br + ph + noises(m, v, gate, trig));
};

//--------------------------------`(cp.)damper_contact`---------------------------------
// Damper contact for a sustain pedal position (`damper_contact`): the fraction of
// the seated damper's loss rate. The dampers stay seated over the first quarter
// of the travel, clear the strings past 0.65, and in between touch lightly (the
// square of the remaining smoothstep travel).
//
// #### Usage
//
// ```
// damper_contact(pos) : _
// ```
//
// Where:
//
// * `pos`: pedal position, 0 up .. 1 down
//
// #### Test
// ```
// cp = library("coopiano.lib");
// damper_contact_test = cp.damper_contact(hslider("pedal", 0, 0, 1, 0.01));
// ```
//----------------------------------------------------------------------------------------
declare damper_contact license "MIT";
damper_contact(pos) = select2(x > 0.0, 1.0, select2(x >= 1.0, s * s, 0.0))
with {
    x = (pos - 0.25) / (0.65 - 0.25);
    s = 1.0 - _smooth01(x);
};


//================================= Compilation helpers ==================================
// Two patterns that keep the model compilable and cheap with faust-rs: sums
// grouped behind an opaque barrier, and computations run only on change.
//========================================================================================

// 1 at the first sample, then 0.
_first = 1 - (1 : mem);

// A barrier the normal form does not cross.
_opaque(x) = max(x, -1.0e300);

//-------------------------------------`(cp.)gsum`--------------------------------------
// Sum of `N` signals in groups of `G`, each group behind an opaque barrier.
// faust-rs normalizes a long sum in a time quadratic in its length (cubic until
// 2026-10-16: 16 s for the soundboard's two 732-term sums; faust-rs-issues/
// RAPPORT.md, point 3); grouping by 32 still saves about 0.5 s of the body's 5 s
// compilation. `N` and `G` are constant numerical expressions.
//
// #### Usage
//
// ```
// si.bus(N) : gsum(N, G) : _
// ```
//
// Where:
//
// * `N`: number of signals
// * `G`: group size
//
// #### Test
// ```
// cp = library("coopiano.lib");
// si = library("signals.lib");
// gsum_test = si.bus(64) : cp.gsum(64, 8);
// ```
//----------------------------------------------------------------------------------------
declare gsum license "MIT";
gsum(n, G) = si.bus(n), par(i, G * ngr - n, 0) : par(g, ngr, (si.bus(G) :> _) : _opaque) :> _
with { ngr = int((n + G - 1) / G); };

//-------------------------------------`(cp.)gsum2`-------------------------------------
// `gsum` of `N` interleaved pairs into two sums (a stereo bus of `N` channels).
//
// #### Usage
//
// ```
// si.bus(2*N) : gsum2(N, G) : _,_
// ```
//
// Where:
//
// * `N`: number of pairs
// * `G`: group size
//
// #### Test
// ```
// cp = library("coopiano.lib");
// si = library("signals.lib");
// gsum2_test = si.bus(64) : cp.gsum2(32, 8);
// ```
//----------------------------------------------------------------------------------------
declare gsum2 license "MIT";
gsum2(n, G) = ro.interleave(2, n) : gsum(n, G), gsum(n, G);

//-----------------------------------`(cp.)on_change`-----------------------------------
// `f(x)` computed only on the samples where `chg` fires, its output held between.
// The voice and the bodies compute their parameters this way. Needs faust-rs
// `c6d9aece` or later, which computes control-rate work in a 0/1 `ondemand` at the
// first fire of each block and stores a held value there (faust-rs-issues/RAPPORT.md,
// point 6); from `aa7027e7` to `75bca56b` the bodies cost up to 45 % more in wasm.
// With an older faust-rs, or with the Faust C++ compiler, the work is hoisted out
// of the domain to block rate and the wasm voice costs 2.2 times as much;
// `(chg, ba.sAndH(chg, x)) : ondemand(f)` (0.2.3) avoids that with any compiler.
//
// #### Usage
//
// ```
// on_change(chg, x, f) : _
// ```
//
// Where:
//
// * `chg`: change pulse (1 when `x` or what `f` reads changed)
// * `x`: the input of `f`
// * `f`: a function of one input (one output in this usage)
//
// #### Test
// ```
// cp = library("coopiano.lib");
// on_change_test = cp.on_change(m != m', m, exp) with { m = hslider("m", 1, 0, 2, 0.01); };
// ```
//----------------------------------------------------------------------------------------
declare on_change license "MIT";
on_change(chg, x, f) = (chg, x) : ondemand(f);


//==================================== Bridge regions ====================================
// The bridge is divided into REGIONS regions, each with its own stereo soundboard
// response; a key mixes into its two nearest regions (Engine's `key_region_`). A
// voice of the instrument hands the body its force per region and the correction
// of its own sympathetic resonators.
//========================================================================================

// Place of a key on the bridge, 0 (A0) .. 1 (C8).
_bridge_pos(m) = _clamp(0.0, 1.0, (m - 21.0) / 87.0);

//----------------------------------`(cp.)region_gain`----------------------------------
// Share of key `m`'s force sent to region `r`: a linear crossfade between the two
// regions nearest to the key's place on the bridge (the last region takes all of
// the top keys).
//
// #### Usage
//
// ```
// region_gain(m, r) : _
// ```
//
// Where:
//
// * `m`: note number
// * `r`: region index, 0 .. REGIONS-1
//
// #### Test
// ```
// cp = library("coopiano.lib");
// region_gain_test = cp.region_gain(hslider("key", 60, 21, 108, 1), 1);
// ```
//----------------------------------------------------------------------------------------
declare region_gain license "MIT";
region_gain(m, r) = select2(r == lower, 0.0, 1.0 - up) + select2(r == lower + 1, 0.0, up)
with {
    x = _bridge_pos(m) * REGIONS - 0.5;
    lower = floor(_clamp(0.0, REGIONS - 1.0, x));
    frac = _clamp(0.0, 1.0, x - lower);
    up = frac * (lower + 1 < REGIONS);
};

//-----------------------------------`(cp.)voice_out`-----------------------------------
// A voice of the instrument (`process` of `dsp/coopiano.dsp`): the key's bridge
// force split over the REGIONS regions, then the correction of its own
// sympathetic resonators, `-(1 - own_drive) gain R_own(F)`, which the body
// spreads over the regions.
//
// #### Usage
//
// ```
// voice_out(m, vel, gate) : _,_,_,_,_
// ```
//
// Where:
//
// * `m`: note number
// * `vel`: velocity in [0.02, 1]
// * `gate`: key down (1) or up (0)
//
// #### Test
// ```
// cp = library("coopiano.lib");
// voice_out_test = cp.voice_out(hslider("key", 60, 21, 108, 1), hslider("velocity", 0.5, 0.02, 1, 0.001), button("gate"));
// ```
//----------------------------------------------------------------------------------------
declare voice_out license "MIT";
voice_out(m, vel, gate) = voice(m, vel, gate) : _regions_out(m);

//--------------------------------`(cp.)voice_out_drawn`--------------------------------
// `voice_out` with given per-strike draws (see `voice_drawn`), for the
// comparisons with the C++ engine.
//
// #### Usage
//
// ```
// voice_out_drawn(m, vel, gate, r0, r1, r2) : _,_,_,_,_
// ```
//
// Where:
//
// * `m`: note number
// * `vel`: velocity in [0.02, 1]
// * `gate`: key down (1) or up (0)
// * `r0`: draw of string 0, in [-1, 1]
// * `r1`: draw of string 1
// * `r2`: draw of string 2
//
// #### Test
// ```
// cp = library("coopiano.lib");
// voice_out_drawn_test = cp.voice_out_drawn(hslider("key", 60, 21, 108, 1), hslider("velocity", 0.5, 0.02, 1, 0.001), button("gate"), -0.732, -0.727, -0.098);
// ```
//----------------------------------------------------------------------------------------
declare voice_out_drawn license "MIT";
voice_out_drawn(m, vel, gate, r0, r1, r2) = voice_drawn(m, vel, gate, r0, r1, r2) : !, _regions_out(m);

// A bridge force split over the regions, then its own-key correction.
_regions_out(m) = _ <: (par(r, REGIONS, *(region_gain(m, r))), (res_own(m) : *((_r_own - 1.0) * _r_gain)));


//================================= Sympathetic register =================================
// `SympatheticResonance`: for each of the 88 keys, its partials up to 16 below
// 7 kHz, each a damped rotation driven by the summed bridge force. A key without a
// damper is always open; the others open as the sustain pedal lifts the dampers
// (a key held silently is not opened: the body does not see the held keys). The
// keys with dampers run in ondemand domains that sleep while the dampers stay
// seated, so a pedal-up instrument pays for the free treble only.
//========================================================================================

// Partial p of key m: open and closed radius, rotation, drive gain
// (`2 (1 - open) / (p (1 + (f/3500)^2))`, zero above 7 kHz), and whether the key
// has a damper.
_res_params(m, p) = op, cl, cos(a), sin(a), drive, key_damper(m)
with {
    f0 = key_f0(m);
    f = p * f0 * sqrt(1.0 + key_B(m) * p * p);
    sigma = _LN1000 / min(key_T60(m), _r_maxdecay) + key_c2(m) * (f * f - f0 * f0);
    op = exp(-sigma * _T);
    cl = exp(0.0 - max(sigma, _LN1000 / _r_damper) * _T);
    a = 2.0 * _PI * f * _T;
    drive = (f <= 7000.0) * 2.0 * (1.0 - op) / (p * (1.0 + (f / 3500.0) * (f / 3500.0)));
};

// One resonator: the drive x and the openness od of the damped keys;
// `_resmode` blends the open and closed radius by the openness.
_resbox(x, od) = \(op, cl, cs, sn, dr, damped).(_resmode(x, select2(damped, 1.0, od), op, cl, cs, sn, dr));
_resmode(x, o, op, cl, cs, sn, dr) = ((\(re, im).(radius_c * (cs * re - sn * im) + dr * o * x, radius_c * (sn * re + cs * im))) ~ (_, _) : _, !)
with { radius_c = cl + o * (op - cl); };

// Openness of the damped keys: the lifted dampers, `1 - damper_contact`,
// reached at 1/transition_seconds per second.
_res_open = (\(o).(o + _clamp(-st, st, 1.0 - damper_contact(_pedal) - o))) ~ _
with { st = 1.0 / (_r_transition * ma.SR); };

// Change pulse of the bank's parameters.
_res_chg = _first | (_r_maxdecay != _r_maxdecay') | (_r_damper != _r_damper') | (_voicing_hash != _voicing_hash');

// The resonators of key g: their parameters, the drive and the openness in.
_res_key_dsp(g) = route(6 * n + 2, 8 * n, par(q, 8 * n, (src(q) + 1, q + 1)))
    : par(p, n, \(op, cl, cs, sn, dr, damped, xx, od).(_resmode(xx, select2(damped, 1.0, od), op, cl, cs, sn, dr)))
    : gsum(n, 32)
with {
    n = ba.take(g + 1, tb.res_n);
    src(q) = select2(q % 8 < 6, 6 * n + q % 8 - 6, 6 * int(q / 8) + q % 8);
};

// A damped key sounds while its dampers are lifted and for six closed T60
// after they seat. Seated is an openness below 1e-9, not 0: faust-rs normalizes
// `(1 - contact) - o` to `1 - (o + contact)` (Faust C++ keeps `1 - contact`
// apart; faust-rs-issues/RAPPORT.md, point 15), so with the pedal up the openness
// settles at the rounding error of `o + 1` (about 1e-17) and never reaches 0,
// which kept the damped keys awake after the first pedal.
_RES_SEATED = 1e-9;
_res_awake(o) = (o > _RES_SEATED) | (quiet < ma.SR * _r_damper * 6.0)
with { quiet = (+(1) : *(o <= _RES_SEATED)) ~ _; };

// Key g's resonators with their parameters, recomputed on change.
_res_key(g, chg, x, o) = (on_change(chg, 21.0 + g, \(b).(par(p, ba.take(g + 1, tb.res_n), _res_params(b, p + 1)))), x, o)
    : _res_key_dsp(g);

//-----------------------------------`(cp.)res_bank`------------------------------------
// The wet output of the sympathetic register for the summed bridge force `x`
// (`SympatheticResonance::process` without its dry term). The parameters of a
// sleeping key are recomputed when it wakes, so a voicing change made while it
// sleeps is not lost. Driven by the C++ force of a C4 strike, it equals the C++
// bank to 1e-12.
//
// #### Usage
//
// ```
// _ : res_bank : _
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// res_bank_test = button("strike") : cp.res_bank;
// ```
//----------------------------------------------------------------------------------------
declare res_bank license "MIT";
res_bank(x) = (par(g, nd, damped(g)), par(g, 88 - nd, _res_key(nd + g, _res_chg, x, _res_open))) : gsum(88, 8)
with {
    nd = tb.res_first_undamped;
    on = _res_awake(_res_open);
    wake = on * (1 - on');
    damped(g) = (on, _res_chg | wake, x, _res_open) : ondemand(_res_key(g)) : *(on);
};

//------------------------------------`(cp.)res_own`------------------------------------
// Key `m`'s own resonators driven by its own force: what `own_drive < 1`
// withholds. The voice subtracts `(1 - own_drive) gain` times it, so that the
// summed bank answers a key only through the rest of the instrument; the bank is
// linear, so this equals withholding the key's share from its drive.
//
// #### Usage
//
// ```
// _ : res_own(m) : _
// ```
//
// Where:
//
// * `m`: note number
//
// #### Test
// ```
// cp = library("coopiano.lib");
// res_own_test = button("strike") : cp.res_own(hslider("key", 60, 21, 108, 1));
// ```
//----------------------------------------------------------------------------------------
declare res_own license "MIT";
res_own(m, x) = sum(p, 16, _res_params(m, p + 1) : _resbox(x, _res_open));


//====================================== Soundboard ======================================
// The C++ soundboard is a sum of 732 modes (48 Hz to 16.5 kHz) passed through a
// minimum-phase equalizer that also removes three quarters of the narrow modal
// ripple, imaged per bridge region. Here it is the same 732 poles with complex
// amplitudes fitted by least squares to Engine's response to an impulse in each
// region (head and shared tail, both channels; `scripts/gen_tables.py`): from
// -22.8 to -25.7 dB of error, 0.1 dB of median magnitude error.
//========================================================================================

// Parameters of a mode: lambda, then Re/Im of the amplitude of each region,
// left then right.
_NBP = 2 + 4 * REGIONS;
_board_params(b, k) = lr, li, par(c, 2, par(r, REGIONS, amp(c, r)))
with {
    i = int(b) + k;
    rd(t) = t, i : rdtable;
    f = rd(tb.board_f);
    sig = rd(tb.board_sig);
    lr = exp(-sig * _T) * cos(2.0 * _PI * f * _T);
    li = exp(-sig * _T) * sin(2.0 * _PI * f * _T);
    amp(0, 0) = rd(tb.board_r0L_re), rd(tb.board_r0L_im);
    amp(0, 1) = rd(tb.board_r1L_re), rd(tb.board_r1L_im);
    amp(0, 2) = rd(tb.board_r2L_re), rd(tb.board_r2L_im);
    amp(0, 3) = rd(tb.board_r3L_re), rd(tb.board_r3L_im);
    amp(1, 0) = rd(tb.board_r0R_re), rd(tb.board_r0R_im);
    amp(1, 1) = rd(tb.board_r1R_re), rd(tb.board_r1R_im);
    amp(1, 2) = rd(tb.board_r2R_re), rd(tb.board_r2R_im);
    amp(1, 3) = rd(tb.board_r3R_re), rd(tb.board_r3R_im);
};

// One mode: its parameters and the region forces in, L and R out, each channel
// a complex one-pole driven by `sum_r A_r x_r`.
_boardbox = \(bl, bi, a0r, a0i, a1r, a1i, a2r, a2i, a3r, a3i, b0r, b0i, b1r, b1i, b2r, b2i, b3r, b3i, x0, x1, x2, x3).(
    _cmode(bl, bi, a0r * x0 + a1r * x1 + a2r * x2 + a3r * x3, a0i * x0 + a1i * x1 + a2i * x2 + a3i * x3),
    _cmode(bl, bi, b0r * x0 + b1r * x1 + b2r * x2 + b3r * x3, b0i * x0 + b1i * x1 + b2i * x2 + b3i * x3));

// A mode with a complex drive, output Im(s); `_bmode` the same with a real
// drive and both parts out (impulse response lambda^n).
_cmode(br_, bi_, ur, ui) = (\(sr, sj).(br_ * sr - bi_ * sj + ur, bi_ * sr + br_ * sj + ui)) ~ (_, _) : !, _;
_bmode(br_, bi_, x) = (\(ur, ui).(br_ * ur - bi_ * ui + x, bi_ * ur + br_ * ui)) ~ (_, _);

// The modes' parameters, in ondemand domains of BG modes, computed once.
_BG = 61;
_board_chunks(chg, f) = par(c, ngr, on_change(chg, 0.0, \(b).(par(i, min(_BG, tb.nb - c * _BG), f(b, c * _BG + i)))))
with { ngr = int((tb.nb + _BG - 1) / _BG); };

//----------------------------------`(cp.)soundboard`-----------------------------------
// The imaged soundboard: the REGIONS region forces in, stereo out (Engine's
// `convolve_span` with the regions' heads and the shared tail). The imaging is
// fixed at the C++ defaults (`spread` 0.7, `position_depth` 0.5).
//
// #### Usage
//
// ```
// _,_,_,_ : soundboard : _,_
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// soundboard_test = (button("strike"), 0, 0, 0) : cp.soundboard;
// ```
//
// #### References
//
// * coopiano `piano.hpp`: `make_soundboard_regions`, `ir_correction`
//----------------------------------------------------------------------------------------
declare soundboard license "MIT";
soundboard = _board_chunks(_first, _board_params), si.bus(REGIONS)
    : route(_NBP * tb.nb + REGIONS, (_NBP + REGIONS) * tb.nb,
            par(o, (_NBP + REGIONS) * tb.nb, (src(o) + 1, o + 1)))
    : par(k, tb.nb, _boardbox) : gsum2(tb.nb, 32)
with {
    src(o) = select2(e < _NBP, _NBP * tb.nb + e - _NBP, _NBP * int(o / (_NBP + REGIONS)) + e)
    with { e = o % (_NBP + REGIONS); };
};

// Without imaging, a mode needs one resonator for both channels: they differ
// only by their complex amplitude.
_mono_params(b, k) = lr, li, rd(tb.board_alr), rd(tb.board_ali), rd(tb.board_arr), rd(tb.board_ari)
with {
    i = int(b) + k;
    rd(t) = t, i : rdtable;
    lr = exp(0.0 - rd(tb.board_sig) * _T) * cos(2.0 * _PI * rd(tb.board_f) * _T);
    li = exp(0.0 - rd(tb.board_sig) * _T) * sin(2.0 * _PI * rd(tb.board_f) * _T);
};
_monobox = \(bl, bi, alr, ali, arr, ari, x).(_bmode(bl, bi, x) <: (\(ur, ui).(alr * ui + ali * ur)), (\(ur, ui).(arr * ui + ari * ur)));

//--------------------------------`(cp.)soundboard_mono`--------------------------------
// The soundboard without imaging (`spread` and `position_depth` 0): the regions
// are summed and each mode drives both channels from one resonator, about a third
// of the imaged board's cost. Fitted to `make_soundboard_ir` to -25.5 dB.
//
// #### Usage
//
// ```
// _,_,_,_ : soundboard_mono : _,_
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// soundboard_mono_test = (button("strike"), 0, 0, 0) : cp.soundboard_mono;
// ```
//----------------------------------------------------------------------------------------
declare soundboard_mono license "MIT";
soundboard_mono = _board_chunks(_first, _mono_params), (si.bus(REGIONS) :> _)
    : route(6 * tb.nb + 1, 7 * tb.nb, par(o, 7 * tb.nb, (select2(o % 7 == 6, 6 * int(o / 7) + o % 7, 6 * tb.nb) + 1, o + 1)))
    : par(k, tb.nb, _monobox) : gsum2(tb.nb, 32);


//=================================== Room and output ====================================
// The room of `reverb.hpp`, the output stage of `instrument.hpp`, and the body of
// the instrument that chains them after the sympathetic register and the
// soundboard.
//========================================================================================

//-------------------------------------`(cp.)room`--------------------------------------
// `StereoReverb` of `reverb.hpp`, line by line: the input high-passed at 150 Hz
// and predelayed, early reflections from six taps (7 to 31 ms), two diffusion
// all-passes per side, eight delay lines with an unnormalised Walsh-Hadamard
// feedback, each damped by a one-pole, added to the dry signal at `mix`.
//
// #### Usage
//
// ```
// _,_ : room : _,_
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// room_test = button("strike") <: cp.room;
// ```
//
// #### References
//
// * J.-M. Jot, A. Chaigne, Digital delay networks for designing artificial reverberators, AES 90th Convention, 1991
//----------------------------------------------------------------------------------------
declare room license "MIT";
room(l, r) = l + _v_mix * (0.45 * el + 0.70 * norm * ll), r + _v_mix * (0.45 * er + 0.70 * norm * lr)
with {
    norm = 0.3535533905932737622;
    sc(n) = max(1, int(n * ma.SR / 44100.0 + 0.5));
    hp(x) = x : fi.zero(1) : fi.pole(exp(-2.0 * _PI * 150.0 / ma.SR));
    pre(x) = x : de.delay(8192, int(_v_predelay * ma.SR / 1000.0 + 0.5));
    il = pre(hp(l));
    ir = pre(hp(r));
    tap(ms) = max(1, int(ms * ma.SR / 1000.0 + 0.5));
    el = 0.55 * il @ tap(7) + 0.30 * ir @ tap(17) - 0.15 * il @ tap(29);
    er = 0.55 * ir @ tap(11) + 0.30 * il @ tap(23) - 0.15 * ir @ tap(31);
    ap(n, x) = (\(b).(0.64 * x + 0.6 * b @ (n - 1))) ~ _ : \(b).(b @ n - 0.6 * x);
    dl = ap(sc(337), ap(sc(191), il));
    dr = ap(sc(373), ap(sc(211), ir));
    len(i) = sc(ba.take(i + 1, (1493, 1601, 1747, 1867, 1999, 2131, 2281, 2423)));
    fb(i) = pow(10.0, -3.0 * len(i) / (ma.SR * _v_decay));
    lp = exp(-2.0 * _PI * _v_damping / ma.SR);
    inr(i) = ba.take(i + 1, (1, 1, 1, 1, -1, -1, -1, -1));
    ol(i) = ba.take(i + 1, (1, 1, -1, -1, 1, 1, -1, -1));
    orr(i) = ba.take(i + 1, (1, -1, 1, -1, 1, -1, 1, -1));
    // Walsh-Hadamard butterflies of widths 1, 2, 4 (unnormalised), as in reverb.hpp.
    wht = \(a0, a1, a2, a3, a4, a5, a6, a7).(a0 + a1, a0 - a1, a2 + a3, a2 - a3, a4 + a5, a4 - a5, a6 + a7, a6 - a7)
        : \(a0, a1, a2, a3, a4, a5, a6, a7).(a0 + a2, a1 + a3, a0 - a2, a1 - a3, a4 + a6, a5 + a7, a4 - a6, a5 - a7)
        : \(a0, a1, a2, a3, a4, a5, a6, a7).(a0 + a4, a1 + a5, a2 + a6, a3 + a7, a0 - a4, a1 - a5, a2 - a6, a3 - a7);
    fdn = \(d0, d1, d2, d3, d4, d5, d6, d7).(
        (d0, d1, d2, d3, d4, d5, d6, d7 : par(i, 8, filt) : wht : par(i, 8, *(fb(i))) : par(i, 8, +(dl + inr(i) * dr)) : par(i, 8, *(norm))),
        sum(i, 8, ol(i) * ba.take(i + 1, (d0, d1, d2, d3, d4, d5, d6, d7))),
        sum(i, 8, orr(i) * ba.take(i + 1, (d0, d1, d2, d3, d4, d5, d6, d7))));
    filt(x) = x * (1.0 - lp) : fi.pole(lp);
    lines = fdn ~ par(i, 8, @(len(i) - 1)) : si.block(8), _, _;
    ll = lines : _, !;
    lr = lines : !, _;
};

//-----------------------------------`(cp.)dc_block`------------------------------------
// The output DC filter of `instrument.hpp` (`DcBlocker`): a one-pole high-pass at
// 20 Hz.
//
// #### Usage
//
// ```
// _ : dc_block : _
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// dc_block_test = button("x") : cp.dc_block;
// ```
//----------------------------------------------------------------------------------------
declare dc_block license "MIT";
dc_block = fi.zero(1) : fi.pole(1.0 - 2.0 * _PI * 20.0 / ma.SR);

//-------------------------------------`(cp.)limit`-------------------------------------
// The soft limiter of `instrument.hpp` (`limit_output`): unchanged up to 0.8, a
// tanh knee to 1 above.
//
// #### Usage
//
// ```
// _ : limit : _
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// limit_test = hslider("x", 0, -2, 2, 0.01) : cp.limit;
// ```
//----------------------------------------------------------------------------------------
declare limit license "MIT";
limit(x) = select2(a <= 0.8, ma.signum(x) * (0.8 + 0.2 * ma.tanh((a - 0.8) / 0.2)), x)
with { a = abs(x); };

//-------------------------------------`(cp.)body`--------------------------------------
// The body of the instrument (the `effect` of `dsp/coopiano.dsp`): the REGIONS
// region forces and the summed own-key corrections of the voices in, stereo out.
// The sympathetic register's wet output and the corrections are spread over the
// regions, then the imaged soundboard, the DC filter, the room, the output gain
// and the limiter.
//
// #### Usage
//
// ```
// _,_,_,_,_ : body : _,_
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// body_test = cp.voice_out(60, 0.5, button("gate")) : cp.body;
// ```
//
// #### References
//
// * coopiano `instrument.hpp`: `render_force`, `convolve_span`, `finish_block`
//----------------------------------------------------------------------------------------
declare body license "MIT";
body(x0, x1, x2, x3, c) = _body_with(soundboard, x0, x1, x2, x3, c);

//----------------------------------`(cp.)body_light`-----------------------------------
// `body` with the soundboard without imaging (`soundboard_mono`): about half the
// cost of the instrument's body (the effect of `dsp/coopiano_light.dsp`).
//
// #### Usage
//
// ```
// _,_,_,_,_ : body_light : _,_
// ```
//
// #### Test
// ```
// cp = library("coopiano.lib");
// body_light_test = cp.voice_out(60, 0.5, button("gate")) : cp.body_light;
// ```
//----------------------------------------------------------------------------------------
declare body_light license "MIT";
body_light(x0, x1, x2, x3, c) = _body_with(soundboard_mono, x0, x1, x2, x3, c);

// The body with a given soundboard.
_body_with(board, x0, x1, x2, x3, c) = (x0 + w, x1 + w, x2 + w, x3 + w) : board : dc_block, dc_block : room
    : *(_out_gain), *(_out_gain) : limit, limit
with {
    w = (_r_gain * res_bank(x0 + x1 + x2 + x3) + c) / REGIONS;
};
